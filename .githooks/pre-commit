#!/usr/bin/env bash
# Pre-commit hook: blocks commits that contain forbidden patterns.
#
# The patterns are loaded from a LOCAL (gitignored) file:
#   .githooks/patterns.local
#
# This list holds sensitive values specific to your environment
# (internal domains, ID formats, hostnames, etc.) and must
# NEVER be committed.
#
# Setup:
#   1. git config core.hooksPath .githooks
#   2. cp .githooks/patterns.example .githooks/patterns.local
#   3. Edit patterns.local with your real patterns

set -eu

HOOK_DIR="$(git rev-parse --show-toplevel)/.githooks"
PATTERNS_FILE="$HOOK_DIR/patterns.local"

if [[ ! -f "$PATTERNS_FILE" ]]; then
    # No local patterns defined — hook inactive, let the commit through
    exit 0
fi

# Load the patterns (one per line, comments and blank lines ignored)
mapfile -t FORBIDDEN_PATTERNS < <(grep -vE '^\s*(#|$)' "$PATTERNS_FILE")
[[ ${#FORBIDDEN_PATTERNS[@]} -eq 0 ]] && exit 0

# Only scan staged files, excluding .githooks/ itself
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^\.githooks/' || true)
[[ -z "$staged" ]] && exit 0

violation=0
for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if matches=$(git diff --cached -U0 -- $staged | grep -iEnH "^\+.*$pattern" 2>/dev/null); then
        if [[ -n "$matches" ]]; then
            echo "Forbidden pattern detected: $pattern" >&2
            echo "$matches" | head -5 >&2
            echo "" >&2
            violation=1
        fi
    fi
done

if (( violation )); then
    echo "=======================================================================" >&2
    echo "Commit blocked: forbidden patterns detected in the staged changes." >&2
    echo "Remove the values above or replace them with generic placeholders." >&2
    echo "" >&2
    echo "Bypass (exceptional): git commit --no-verify" >&2
    echo "=======================================================================" >&2
    exit 1
fi

exit 0
