#!/usr/bin/env bash
# Commit-msg hook: enforces the Conventional Commits format.
#
# Expected format: <type>(<scope>): <description>
#   type     : feat | fix | docs | style | refactor | perf | test | chore | build | ci | revert
#   scope    : optional, in parentheses (e.g. auth, config, expect)
#   ! after scope/type marks a breaking change (e.g. feat!: drop -s flag)
#
# Full spec: https://www.conventionalcommits.org/

set -eu

msg_file="$1"
first_line=$(head -1 "$msg_file")

# Let through the technical commits generated by Git (merge, revert, interactive rebase)
if [[ "$first_line" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
    exit 0
fi

# Conventional Commits regex (type required, scope and ! optional)
pattern='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-z0-9_-]+\))?!?: .+'

if ! [[ "$first_line" =~ $pattern ]]; then
    cat >&2 <<EOF
Commit message does not follow the Conventional Commits standard.

Expected format: <type>(<scope>): <description>

Valid types:
  feat      new feature
  fix       bug fix
  docs      documentation only
  style     formatting, whitespace (no logic change)
  refactor  neither a bug fix nor a feature
  perf      performance improvement
  test      add or change tests
  chore     maintenance (deps, tooling)
  build     build system
  ci        CI configuration
  revert    revert a commit

Examples:
  feat: add LDAP user fallback
  fix(auth): prevent silent exit on ssh -G failure
  docs(readme): document config file precedence
  refactor(fetch): extract quiet flag from stderr redirect
  feat!: drop -s flag, auto-sudo is now default

Your message was:
  $first_line

Bypass (exceptional): git commit --no-verify
EOF
    exit 1
fi

# First-line length warning (72 chars recommended for proper display)
if (( ${#first_line} > 72 )); then
    echo "Warning: long first line (${#first_line} chars > 72 recommended)" >&2
    echo "         Prefer a short summary + details in the commit body" >&2
fi

exit 0
