#!/usr/bin/env bash
# psm — SSH via CyberArk PSMP avec récupération automatique des credentials
#       depuis KeePassXC (Secret Service API, fallback keepassxc-cli).
#
# Flow : ssh vaultuser@targetuser@targethost@psmphost
#        - Prompt "Vault Password:" → mot de passe vault CyberArk
#        - Prompt "Password:"       → mot de passe target
#        - Shell interactif sur le serveur cible

set -euo pipefail

# =============================================================================
# CONFIG (surchargeable via variables d'environnement)
# =============================================================================
PSMP_HOST="${PSMP_HOST:-psmp.example.com}"
VAULT_USER="${VAULT_USER:-ton.vault.user}"
KDBX_PATH="${KDBX_PATH:-$HOME/Passwords.kdbx}"
KDBX_GROUP="${KDBX_GROUP:-PSM}"
VAULT_PASS_ENTRY="${VAULT_PASS_ENTRY:-VaultPassword}"
SSH_OPTS="${SSH_OPTS:--o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o LogLevel=ERROR}"
EXPECT_TIMEOUT="${EXPECT_TIMEOUT:-30}"
SESSION_TIMEOUT="${SESSION_TIMEOUT:-60}"

# =============================================================================
# Couleurs (désactivées si stderr n'est pas un terminal)
# =============================================================================
if [[ -t 2 ]]; then
    C_RED=$'\033[31m'
    C_GRN=$'\033[32m'
    C_YLW=$'\033[33m'
    C_CYN=$'\033[36m'
    C_RST=$'\033[0m'
else
    C_RED='' C_GRN='' C_YLW='' C_CYN='' C_RST=''
fi

err()   { printf '%s[ERR]%s  %s\n'  "$C_RED" "$C_RST" "$*" >&2; }
warn()  { printf '%s[WARN]%s %s\n'  "$C_YLW" "$C_RST" "$*" >&2; }
info()  { printf '%s[INFO]%s %s\n'  "$C_CYN" "$C_RST" "$*" >&2; }
debug() { [[ "${DEBUG:-0}" == 1 ]] && printf '%s[DBG]%s  %s\n' "$C_GRN" "$C_RST" "$*" >&2 || true; }

# =============================================================================
# Aide
# =============================================================================
usage() {
    cat <<EOF
Usage: psm [options] <targetuser@targethost>

Connecte à un serveur cible via le proxy CyberArk PSMP.
Récupère les mots de passe (vault + target) depuis KeePassXC.

Options:
  -d          Debug mode (affiche tous les échanges expect)
  -l          Liste les targets disponibles dans KeePassXC
  -p PORT     Port SSH du PSMP (défaut: 22)
  -v VUSER    Override du vault user (défaut: \$VAULT_USER)
  -h          Affiche cette aide

Exemples:
  psm admin@srv-prod01
  psm -d root@switch-core01
  psm -p 2222 admin@srv-prod01
  psm -l

Configuration courante:
  PSMP_HOST          = $PSMP_HOST
  VAULT_USER         = $VAULT_USER
  KDBX_GROUP         = $KDBX_GROUP
  VAULT_PASS_ENTRY   = $VAULT_PASS_ENTRY

Variables d'environnement supportées:
  PSMP_HOST, VAULT_USER, KDBX_PATH, KDBX_GROUP,
  VAULT_PASS_ENTRY, SSH_OPTS, EXPECT_TIMEOUT, SESSION_TIMEOUT
EOF
}

# =============================================================================
# Vérification des dépendances
# =============================================================================
check_deps() {
    local missing=()
    command -v expect      >/dev/null 2>&1 || missing+=("expect")
    command -v secret-tool >/dev/null 2>&1 || missing+=("secret-tool (paquet libsecret-tools)")
    command -v ssh         >/dev/null 2>&1 || missing+=("ssh")

    if (( ${#missing[@]} > 0 )); then
        err "Dépendances manquantes :"
        for m in "${missing[@]}"; do err "  - $m"; done
        err "Installation Debian/Ubuntu : apt install expect libsecret-tools openssh-client"
        err "Installation RHEL/Fedora   : dnf install expect libsecret openssh-clients"
        exit 2
    fi

    if ! command -v keepassxc-cli >/dev/null 2>&1; then
        debug "keepassxc-cli absent : fallback désactivé"
    fi
}

# =============================================================================
# Récupération d'un mot de passe : Secret Service → fallback keepassxc-cli
# =============================================================================
fetch_password() {
    local entry="$1"
    local pass=""

    # 1. Secret Service (KeePassXC GUI déverrouillé + intégration activée)
    if pass=$(secret-tool lookup Title "$entry" 2>/dev/null) && [[ -n "$pass" ]]; then
        debug "Mot de passe récupéré via secret-tool pour '$entry'"
        printf '%s' "$pass"
        return 0
    fi

    debug "secret-tool a échoué pour '$entry', tentative keepassxc-cli"

    # 2. Fallback keepassxc-cli (demande master password interactivement)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        info "Fallback keepassxc-cli : master password requis pour $KDBX_PATH"
        if pass=$(keepassxc-cli show -qsa Password "$KDBX_PATH" "$KDBX_GROUP/$entry" 2>/dev/null) \
           && [[ -n "$pass" ]]; then
            debug "Mot de passe récupéré via keepassxc-cli pour '$entry'"
            printf '%s' "$pass"
            return 0
        fi
    fi

    err "Impossible de récupérer le mot de passe pour : $entry"
    err "Vérifie que :"
    err "  - KeePassXC est ouvert et déverrouillé"
    err "  - L'intégration Secret Service est activée"
    err "  - Le groupe '$KDBX_GROUP' est exposé"
    err "  - L'entrée '$entry' existe avec le titre exact"
    return 1
}

# =============================================================================
# Liste des targets disponibles depuis KeePassXC
# =============================================================================
list_targets() {
    info "Targets disponibles dans le groupe '$KDBX_GROUP' :"

    # secret-tool search retourne les entrées avec un attribut donné
    # On cherche celles ayant un attribut xdg:schema (toutes les entrées KeePassXC)
    # puis on filtre par format user@host
    local found=0
    while IFS= read -r title; do
        if [[ "$title" == *@* && "$title" != "$VAULT_PASS_ENTRY" ]]; then
            printf '  %s\n' "$title"
            found=1
        fi
    done < <(secret-tool search --all xdg:schema org.freedesktop.Secret.Generic 2>/dev/null | \
             awk -F' = ' '/^attribute\.Title/ {print $2}' | sort -u)
    if (( found )); then
        return 0
    fi

    # fallback keepassxc-cli
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        warn "secret-tool indisponible, fallback keepassxc-cli (master password requis)"
        keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null | \
            grep -v '^VaultPassword' | sed 's/^/  /'
        return 0
    fi

    err "Aucune source disponible pour lister les targets"
    return 1
}

# =============================================================================
# Connexion SSH via expect
# =============================================================================
connect() {
    local target="$1" port="$2"
    local target_user="${target%@*}"
    local target_host="${target#*@}"

    if [[ -z "$target_user" || -z "$target_host" || "$target_user" == "$target" ]]; then
        err "Format invalide : '$target' (attendu: user@host)"
        exit 2
    fi

    # Résolution du hostname : SSH config → /etc/hosts + DNS → tel quel
    local original_host="$target_host"
    local resolved
    # 1. ~/.ssh/config (Host → HostName, wildcards, Includes...)
    resolved=$(ssh -G "$target_host" 2>/dev/null | awk '/^hostname / {print $2}')
    [[ -n "$resolved" ]] && target_host="$resolved"
    # 2. /etc/hosts + DNS (si encore un hostname, pas une IP)
    if [[ ! "$target_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        local ip
        ip=$(getent hosts "$target_host" 2>/dev/null | awk '{print $1}')
        [[ -n "$ip" ]] && target_host="$ip"
    fi
    if [[ "$target_host" != "$original_host" ]]; then
        debug "Résolution : $original_host → $target_host"
    fi

    info "Cible : $target_user @ $target_host (via $PSMP_HOST:$port)"

    # Récupération des deux mots de passe
    # Essai nom original (app@srv-prod01) puis nom résolu (app@10.2.2.2)
    local vault_pass target_pass=""
    local resolved_target="${target_user}@${target_host}"
    vault_pass=$(fetch_password "$VAULT_PASS_ENTRY") || exit 3
    target_pass=$(fetch_password "$target" 2>/dev/null) || true
    if [[ -z "$target_pass" && "$resolved_target" != "$target" ]]; then
        debug "Lookup '$target' échoué, tentative '$resolved_target'"
        target_pass=$(fetch_password "$resolved_target") || exit 3
    elif [[ -z "$target_pass" ]]; then
        # Pas de résolution alternative, relance pour afficher l'erreur
        fetch_password "$target"
        exit 3
    fi

    # Construction de la string de connexion CyberArk (IP résolue pour le PSMP)
    local conn_str="${VAULT_USER}@${target_user}@${target_host}@${PSMP_HOST}"
    debug "Spawn: ssh -p $port $SSH_OPTS $conn_str"

    # Export des passwords vers expect via env (jamais sur la cmdline)
    export VAULT_PASS="$vault_pass"
    export TARGET_PASS="$target_pass"
    unset vault_pass target_pass

    # Mode debug expect
    local log_init=0
    [[ "${DEBUG:-0}" == 1 ]] && log_init=1

    # =========================================================================
    # Script expect — séquence d'auth keyboard-interactive
    # =========================================================================
    local rc=0
    expect <<EXPECT_EOF || rc=$?
        # En debug, on voit tout ; sinon on masque le banner initial
        log_user $log_init
        set timeout $EXPECT_TIMEOUT

        # Lancement de la connexion SSH vers le PSMP
        spawn -noecho ssh -p $port $SSH_OPTS $conn_str

        # ---------------------------------------------------------------------
        # Étape 1 : Vault Password
        # ---------------------------------------------------------------------
        expect {
            -re {(?i)vault password\s*:\s*\$} {
                log_user 1
                send -- "\$env(VAULT_PASS)\r"
            }
            -re {(?i)permission denied} {
                send_user "\n${C_RED}[ERR]${C_RST}  Permission refusée avant prompt vault\n"
                exit 10
            }
            timeout {
                send_user "\n${C_RED}[ERR]${C_RST}  Timeout en attendant 'Vault Password:'\n"
                exit 11
            }
            eof {
                send_user "\n${C_RED}[ERR]${C_RST}  Connexion fermée avant prompt vault\n"
                exit 12
            }
        }

        # ---------------------------------------------------------------------
        # Étape 2 : Target Password (ou erreur vault)
        # ---------------------------------------------------------------------
        expect {
            # Re-prompt vault → mauvais vault password
            -re {(?i)vault password\s*:\s*\$} {
                send_user "\n${C_RED}[ERR]${C_RST}  Authentification vault échouée (mauvais VaultPassword)\n"
                exit 20
            }
            # MFA non supporté
            -re {(?i)(otp|one-time password|mfa code)\s*:\s*\$} {
                send_user "\n${C_RED}[ERR]${C_RST}  MFA détecté — non supporté par ce script\n"
                exit 21
            }
            -re {(?i)permission denied} {
                send_user "\n${C_RED}[ERR]${C_RST}  Permission refusée après vault password\n"
                exit 22
            }
            # Prompt target — différents formats possibles
            -re {(?i)password\s*:\s*\$} {
                send -- "\$env(TARGET_PASS)\r"
            }
            timeout {
                send_user "\n${C_RED}[ERR]${C_RST}  Timeout en attendant le prompt target\n"
                exit 23
            }
            eof {
                send_user "\n${C_RED}[ERR]${C_RST}  Connexion fermée avant prompt target\n"
                exit 24
            }
        }

        # ---------------------------------------------------------------------
        # Étape 3 : vérification d'auth target puis interact
        # ---------------------------------------------------------------------
        expect {
            -re {(?i)permission denied} {
                send_user "\n${C_RED}[ERR]${C_RST}  Authentification target échouée\n"
                exit 30
            }
            -re {(?i)password\s*:\s*\$} {
                send_user "\n${C_RED}[ERR]${C_RST}  Re-prompt target → mauvais TARGET_PASS\n"
                exit 31
            }
            timeout {
                # Timeout ici = silence après envoi → on suppose que le shell est prêt
                # (certains serveurs n'affichent rien avant le prompt)
            }
            -re {[\$#>]\s*\$} {
                # Prompt shell détecté
            }
            eof {
                send_user "\n${C_RED}[ERR]${C_RST}  Connexion fermée après auth target\n"
                exit 32
            }
        }

        # Bascule en mode interactif : l'utilisateur reprend le contrôle
        set timeout -1
        interact
EXPECT_EOF

    # Nettoyage immédiat des secrets en mémoire (exécuté même si expect échoue)
    unset VAULT_PASS TARGET_PASS

    return $rc
}

# =============================================================================
# Parsing CLI
# =============================================================================
DEBUG=0
PORT=22
LIST_ONLY=0

while getopts ":dlp:v:h" opt; do
    case "$opt" in
        d) DEBUG=1 ;;
        l) LIST_ONLY=1 ;;
        p) PORT="$OPTARG" ;;
        v) VAULT_USER="$OPTARG" ;;
        h) usage; exit 0 ;;
        \?) err "Option inconnue : -$OPTARG"; usage; exit 2 ;;
        :)  err "Option -$OPTARG requiert un argument"; exit 2 ;;
    esac
done
shift $((OPTIND - 1))

check_deps

if (( LIST_ONLY == 1 )); then
    list_targets
    exit $?
fi

if (( $# != 1 )); then
    err "Argument manquant : <targetuser@targethost>"
    usage
    exit 2
fi

# Validation port
if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
    err "Port invalide : $PORT"
    exit 2
fi

connect "$1" "$PORT"
