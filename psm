#!/usr/bin/env bash
# psm — SSH through a CyberArk PSMP with automatic credential retrieval
#       from KeePassXC (Secret Service API, keepassxc-cli fallback).
#
# Flow: ssh vaultuser@targetuser@targethost@psmphost
#   SSH key mode : transparent vault auth (ssh-agent) → target "Password:"
#   Password mode: "Vault Password:" → target "Password:"
#   → Interactive shell on the target server

set -euo pipefail

# =============================================================================
# CONFIG — the script looks for a config file in this order:
#   1. $PSM_CONFIG (if set)
#   2. ~/.config/psm/config
#   3. ~/.psmrc
# The first one found is sourced. If none is found, the defaults below apply.
#
# Precedence (depends on how you write the config file):
#   - `VAULT_USER="foo"`              → config overrides the environment
#   - `: "${VAULT_USER:=foo}"`        → environment keeps priority
# =============================================================================
PSM_CONFIG="${PSM_CONFIG:-}"
PSM_CONFIG_LOADED=""    # path of the config file actually sourced (shown by psm doctor)
for _candidate in "$PSM_CONFIG" "$HOME/.config/psm/config" "$HOME/.psmrc"; do
    if [[ -n "$_candidate" && -f "$_candidate" ]]; then
        # shellcheck source=/dev/null
        source "$_candidate"
        PSM_CONFIG_LOADED="$_candidate"
        break
    fi
done
unset _candidate

PSMP_HOST="${PSMP_HOST:-psmp.example.com}"
VAULT_USER="${VAULT_USER:-your.vault.user}"
KDBX_PATH="${KDBX_PATH:-$HOME/Passwords.kdbx}"
KDBX_GROUP="${KDBX_GROUP:-PSM}"
VAULT_PASS_ENTRY="${VAULT_PASS_ENTRY:-VaultPassword}"
GPG_MASTER_FILE="${GPG_MASTER_FILE:-$HOME/.psm-master.gpg}"
LDAP_USER="${LDAP_USER:-}"  # list of LDAP/AD users (space-separated), e.g. "john.doe jane.smith"
SSH_OPTS="${SSH_OPTS:--o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o LogLevel=ERROR}"
EXPECT_TIMEOUT="${EXPECT_TIMEOUT:-30}"
AUTO_SUDO="${AUTO_SUDO:-1}"  # 1 = auto-fill [sudo] prompts with TARGET_PASS; 0 = manual sudo

# =============================================================================
# Colors (disabled when stderr is not a terminal)
# =============================================================================
if [[ -t 2 ]]; then
    C_RED=$'\033[31m'
    C_GRN=$'\033[32m'
    C_YLW=$'\033[33m'
    C_CYN=$'\033[36m'
    C_RST=$'\033[0m'
else
    C_RED='' C_GRN='' C_YLW='' C_CYN='' C_RST=''
fi

err()   { printf '%s[ERR]%s  %s\n'  "$C_RED" "$C_RST" "$*" >&2; }
warn()  { printf '%s[WARN]%s %s\n'  "$C_YLW" "$C_RST" "$*" >&2; }
info()  { printf '%s[INFO]%s %s\n'  "$C_CYN" "$C_RST" "$*" >&2; }
debug() { [[ "${DEBUG:-0}" == 1 ]] && printf '%s[DBG]%s  %s\n' "$C_GRN" "$C_RST" "$*" >&2 || true; }

# =============================================================================
# Help
# =============================================================================
usage() {
    cat <<EOF
Usage: psm [options] <targetuser@targethost|targethost> [command]
       psm [options] cp [scp-flags] SRC... DST
       psm doctor      Check the installation (changes nothing)
       psm setup       Guided installation: packages, psm link, config,
                       ssh-agent, GPG, KeePassXC database, ~/.bashrc

Connects to a target server through the CyberArk PSMP proxy.
Retrieves the passwords (vault + target) from KeePassXC.

If the target is a bare hostname (e.g. 'srv-prod01'), the user is taken
from the 'User' field of ~/.ssh/config for that host.

Options:
  -d          Debug mode (shows all expect exchanges)
  -S          Disable auto-sudo for this session (manual sudo)
  -l          List the targets available in KeePassXC
  -p PORT     PSMP SSH port (default: 22)
  -v VUSER    Override the vault user (default: \$VAULT_USER)
  -h          Show this help

Examples:
  psm admin@srv-prod01            # explicit user@host syntax
  psm srv-prod01                  # user taken from ~/.ssh/config
  psm -d root@switch-core01
  psm -p 2222 admin@srv-prod01
  psm -l
  psm srv-prod01 "systemctl status nginx"   # run a command (non-interactive)
  psm cp ./deploy.sh srv-prod01:/tmp/        # push a file (scp)
  psm cp srv-prod01:/etc/hosts .             # fetch a file
  psm cp -r ./dist srv-prod01:/var/www/      # recursive transfer

Current configuration:
  PSMP_HOST          = $PSMP_HOST
  VAULT_USER         = $VAULT_USER
  KDBX_GROUP         = $KDBX_GROUP
  VAULT_PASS_ENTRY   = $VAULT_PASS_ENTRY
  LDAP_USER          = ${LDAP_USER:-<unset>}
  AUTO_SUDO          = ${AUTO_SUDO:-1}

Supported environment variables:
  PSMP_HOST, VAULT_USER, KDBX_PATH, KDBX_GROUP,
  VAULT_PASS_ENTRY, GPG_MASTER_FILE, LDAP_USER,
  SSH_OPTS, EXPECT_TIMEOUT, AUTO_SUDO

Per-host PSMP override (~/.ssh/config):
  Host LC*
      SetEnv PSM_PSMP_HOST=psmp-secure.example.com
EOF
}

# =============================================================================
# Dependency check
# =============================================================================
check_deps() {
    local missing=()
    command -v expect >/dev/null 2>&1 || missing+=("expect")
    command -v ssh    >/dev/null 2>&1 || missing+=("ssh")

    if (( ${#missing[@]} > 0 )); then
        err "Missing dependencies:"
        for m in "${missing[@]}"; do err "  - $m"; done
        err "Install on Debian/Ubuntu: apt install expect openssh-client"
        err "Install on RHEL/Fedora  : dnf install expect openssh-clients"
        exit 2
    fi

    # Credential sources: at least one is required
    local has_secret_tool=0 has_keepassxc=0
    command -v secret-tool   >/dev/null 2>&1 && has_secret_tool=1
    command -v keepassxc-cli >/dev/null 2>&1 && has_keepassxc=1

    if (( !has_secret_tool && !has_keepassxc )); then
        err "No credential source available"
        err "Install at least one of the following tools:"
        err "  - secret-tool   (libsecret-tools): KeePassXC GUI + Secret Service"
        err "  - keepassxc-cli                  : command line + GPG"
        exit 2
    fi

    (( has_secret_tool )) || debug "secret-tool not found: Secret Service mode disabled"
    (( has_keepassxc ))   || debug "keepassxc-cli not found: CLI mode disabled"
}

# =============================================================================
# Password retrieval: Secret Service → keepassxc-cli fallback
# =============================================================================
fetch_password() {
    local entry="$1"
    local quiet="${2:-0}"
    local pass=""

    # 1. Secret Service (KeePassXC GUI unlocked + integration enabled)
    if command -v secret-tool >/dev/null 2>&1; then
        if pass=$(secret-tool lookup Title "$entry" 2>/dev/null) && [[ -n "$pass" ]]; then
            debug "Password retrieved via secret-tool for '$entry'"
            printf '%s' "$pass"
            return 0
        fi
        debug "secret-tool failed for '$entry', trying keepassxc-cli"
    fi

    # 2. keepassxc-cli with the master password decrypted by GPG (gpg-agent caches the passphrase)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        if [[ -f "$GPG_MASTER_FILE" ]] && command -v gpg >/dev/null 2>&1; then
            debug "Decrypting the master password via GPG ($GPG_MASTER_FILE)"
            if pass=$(gpg -qd "$GPG_MASTER_FILE" 2>/dev/null \
                       | keepassxc-cli show -qsa Password "$KDBX_PATH" "$KDBX_GROUP/$entry" 2>/dev/null) \
               && [[ -n "$pass" ]]; then
                debug "Password retrieved via keepassxc-cli + GPG for '$entry'"
                printf '%s' "$pass"
                return 0
            fi
        fi

        # 3. Interactive fallback — only when GPG is NOT configured
        # (if GPG_MASTER_FILE exists, the database is assumed to be decryptable:
        # a failure means "entry not found", not "database unreachable" — so
        # there is no point prompting for the master password interactively)
        # The -q flag is dropped here because it suppressed the master password prompt.
        if (( ! quiet )) && [[ ! -f "$GPG_MASTER_FILE" ]]; then
            debug "Interactive keepassxc-cli fallback for '$entry'"
            if pass=$(keepassxc-cli show -sa Password "$KDBX_PATH" "$KDBX_GROUP/$entry") \
               && [[ -n "$pass" ]]; then
                debug "Password retrieved via keepassxc-cli for '$entry'"
                printf '%s' "$pass"
                return 0
            fi
        fi
    fi

    if (( quiet )); then
        debug "Silent lookup failed for '$entry'"
        return 1
    fi

    err "Unable to retrieve the password for: $entry"
    err "Check that:"
    err "  - KeePassXC is open and unlocked (Secret Service mode)"
    err "  - Or ~/.psm-master.gpg exists (keepassxc-cli + GPG mode)"
    err "  - The '$KDBX_GROUP' group contains the '$entry' entry"
    return 1
}

# =============================================================================
# List the targets available in KeePassXC
# =============================================================================
list_targets() {
    info "Targets available in group '$KDBX_GROUP':"

    # secret-tool search returns the entries that have a given attribute.
    # We look for entries with an xdg:schema attribute (all KeePassXC entries)
    # and then keep the ones in user@host format.
    local found=0
    if command -v secret-tool >/dev/null 2>&1; then
        while IFS= read -r title; do
            if [[ "$title" == *@* && "$title" != "$VAULT_PASS_ENTRY" ]]; then
                printf '  %s\n' "$title"
                found=1
            fi
        done < <(secret-tool search --all xdg:schema org.freedesktop.Secret.Generic 2>/dev/null | \
                 awk -F' = ' '/^attribute\.Title/ {print $2}' | sort -u)
    fi
    if (( found )); then
        return 0
    fi

    # keepassxc-cli fallback (GPG first, then interactive)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        local entries=""
        if [[ -f "$GPG_MASTER_FILE" ]] && command -v gpg >/dev/null 2>&1; then
            debug "Listing via keepassxc-cli + GPG"
            entries=$(gpg -qd "$GPG_MASTER_FILE" 2>/dev/null \
                      | keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null) || true
        fi
        if [[ -z "$entries" ]]; then
            warn "Interactive keepassxc-cli fallback (master password required)"
            entries=$(keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null) || true
        fi
        if [[ -n "$entries" ]]; then
            printf '%s\n' "$entries" | grep -v '^VaultPassword' | sed 's/^/  /'
            return 0
        fi
    fi

    err "No source available to list the targets"
    return 1
}

# =============================================================================
# Parsing of the `psm cp` arguments: finds the single remote spec
# (standard scp rule: a ':' before any '/', form [user@]host:path).
# Flags (-x) and local paths are ignored for the detection.
# =============================================================================
parse_scp_args() {
    PSA_REMOTE_HOST=""
    PSA_REMOTE_PATH=""
    PSA_REMOTE_INDEX=-1
    PSA_ARGV=("$@")
    local i arg count=0
    for i in "${!PSA_ARGV[@]}"; do
        arg="${PSA_ARGV[$i]}"
        [[ "$arg" == -* ]] && continue          # scp flag: never a remote spec
        if [[ "$arg" =~ ^[^/]*: ]]; then         # ':' before any '/'
            PSA_REMOTE_INDEX=$i
            PSA_REMOTE_HOST="${arg%%:*}"
            PSA_REMOTE_PATH="${arg#*:}"
            (( count++ )) || true
        fi
    done

    if (( count == 0 )); then
        err "psm cp: no remote target (expected 'host:/path')"
        return 2
    fi
    if (( count > 1 )); then
        err "psm cp: remote-to-remote transfer is not supported (a single 'host:/path' target)"
        return 2
    fi
    return 0
}

# =============================================================================
# Target resolution + credential fetch
# =============================================================================
resolve_target() {
    # Single-shot per invocation: the R_* globals are not reset on entry (only
    # R_PSMP_HOST is re-initialized). Do not call this in a loop without an exit
    # in between, or R_* values from a previous call could persist.
    local target="$1" port="$2"
    local target_user="" target_host=""
    R_PSMP_HOST="$PSMP_HOST"

    # Parse the target: 'user@host' or bare 'host' (the user is then taken from ~/.ssh/config)
    if [[ "$target" == *@* ]]; then
        target_user="${target%@*}"
        target_host="${target#*@}"
        if [[ -z "$target_user" || -z "$target_host" ]]; then
            err "Invalid format: '$target' (expected: user@host or host)"
            exit 2
        fi
    else
        target_host="$target"
    fi

    # Resolution via ssh -G: gets the hostname AND the user (if not given)
    local original_host="$target_host"
    local ssh_g_output
    debug "Resolving ssh -G $target_host"
    local ssh_g_stderr="/dev/null"
    [[ "${DEBUG:-0}" == 1 ]] && ssh_g_stderr="/dev/stderr"
    if ! ssh_g_output=$(ssh -G "$target_host" 2>"$ssh_g_stderr"); then
        err "ssh -G failed for '$target_host' — check ~/.ssh/config"
        exit 2
    fi

    local resolved
    resolved=$(awk '/^hostname / {print $2}' <<< "$ssh_g_output")
    [[ -n "$resolved" ]] && target_host="$resolved"

    # If no user was given on the command line, take it from ssh -G
    if [[ -z "$target_user" ]]; then
        target_user=$(awk '/^user / {print $2}' <<< "$ssh_g_output")
        if [[ -z "$target_user" ]]; then
            err "No user specified for '$original_host'"
            err "Use the 'user@host' syntax or add 'User xxx' to ~/.ssh/config"
            exit 2
        fi
        debug "User taken from ~/.ssh/config: $target_user"
    fi

    # Override PSMP_HOST if SetEnv PSM_PSMP_HOST=... is set in ~/.ssh/config
    # (e.g. Host LC*  /  SetEnv PSM_PSMP_HOST=psmp-secure.example.com)
    local host_psmp
    host_psmp=$(awk '/^setenv PSM_PSMP_HOST=/ {sub(/^setenv PSM_PSMP_HOST=/,""); print; exit}' <<< "$ssh_g_output")
    if [[ -n "$host_psmp" ]]; then
        debug "PSMP_HOST overridden by ~/.ssh/config: $PSMP_HOST → $host_psmp"
        R_PSMP_HOST="$host_psmp"
    fi
    # 2. /etc/hosts + DNS (2s timeout to avoid hanging)
    if [[ ! "$target_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        debug "DNS resolution: getent hosts $target_host (2s timeout)"
        local ip
        ip=$(timeout 2 getent hosts "$target_host" 2>/dev/null | awk '{print $1}') || true
        if [[ -n "$ip" ]]; then
            target_host="$ip"
        else
            debug "DNS not resolved, hostname passed as is"
        fi
    fi
    if [[ "$target_host" != "$original_host" ]]; then
        debug "Resolution: $original_host → $target_host"
        info "Target: $target_user @ $original_host → $target_host (via $R_PSMP_HOST:$port)"
    else
        info "Target: $target_user @ $target_host (via $R_PSMP_HOST:$port)"
    fi

    # Vault password: not needed with SSH key auth (agent running with loaded keys)
    local vault_pass="" target_pass=""
    local original_target="${target_user}@${original_host}"
    local resolved_target="${target_user}@${target_host}"
    debug "Checking ssh-agent"
    if ssh-add -l >/dev/null 2>&1; then
        info "SSH key mode (agent running, keys loaded)"
    else
        debug "No SSH key, fetching the vault password"
        vault_pass=$(fetch_password "$VAULT_PASS_ENTRY" 1) || true
        if [[ -n "$vault_pass" ]]; then
            info "Password mode (vault password from KeePassXC)"
        else
            # SSH keys present but not loaded → actionable error
            local unloaded_keys
            unloaded_keys=$(find ~/.ssh -maxdepth 1 -name "id_*" ! -name "*.pub" 2>/dev/null)
            if [[ -n "$unloaded_keys" ]]; then
                err "SSH keys found but not loaded in the agent:"
                while IFS= read -r kf; do err "  - $kf"; done <<< "$unloaded_keys"
                err "Load them first: ssh-add"
                exit 2
            fi
            warn "No vault password, and ssh-agent has no key loaded"
            warn "If the PSMP asks for a vault password, the connection will fail"
        fi
    fi

    # Target password: required
    # Lookup order — depends on whether target_user is a known LDAP account (LDAP_USER)
    #   Known LDAP account: user → user@ip → user@hostname  (single entry, same password everywhere)
    #   Service account   : user@ip → user@hostname → user  (specific before generic)
    local is_ldap=0 u
    for u in $LDAP_USER; do
        if [[ "$target_user" == "$u" ]]; then
            is_ldap=1
            break
        fi
    done

    local lookup_names=()
    if (( is_ldap )); then
        debug "User '$target_user' identified as an LDAP account (via LDAP_USER)"
        lookup_names=("$target_user")
        if [[ "$resolved_target" != "$original_target" ]]; then
            lookup_names+=("$resolved_target" "$original_target")
        else
            lookup_names+=("$original_target")
        fi
    else
        if [[ "$resolved_target" != "$original_target" ]]; then
            lookup_names=("$resolved_target" "$original_target" "$target_user")
        else
            lookup_names=("$original_target" "$target_user")
        fi
    fi

    info "Looking up the target password in KeePassXC..."
    local found_name=""
    for name in "${lookup_names[@]}"; do
        debug "Lookup '$name'"
        target_pass=$(fetch_password "$name" 1) || true
        if [[ -n "$target_pass" ]]; then
            found_name="$name"
            break
        fi
    done

    if [[ -z "$target_pass" ]]; then
        err "No KeePassXC entry found for '$target_user'"
        err "Names tried:"
        for name in "${lookup_names[@]}"; do
            err "  - $KDBX_GROUP/$name"
        done
        err "Create an entry with one of these Titles in group '$KDBX_GROUP'"
        exit 3
    fi
    info "Password found (entry: $KDBX_GROUP/$found_name)"

    # Build the CyberArk connection string (resolved IP for the PSMP)
    R_TARGET_USER="$target_user"
    R_TARGET_HOST="$target_host"
    R_ORIGINAL_HOST="$original_host"
    R_VAULT_PASS="$vault_pass"
    R_TARGET_PASS="$target_pass"
    R_CONN_STR="${VAULT_USER}@${target_user}@${target_host}@${R_PSMP_HOST}"
    unset vault_pass target_pass
}

# =============================================================================
# Expect preamble shared by the 3 modes: vault auth (optional) → target.
# $1 = full `spawn` line (Tcl syntax; literal \$env(...)).
# Writes the script to stdout.
# =============================================================================
emit_auth_preamble() {
    local spawn_line="$1"
    local log_init=0 exp_debug=0
    if [[ "${DEBUG:-0}" == 1 ]]; then
        log_init=1
        exp_debug=1
    fi

    # Escaping convention (NON-quoted heredoc <<EXPECT_EOF):
    #   $var   → expanded by bash   ($spawn_line, $EXPECT_TIMEOUT, $VAULT_PASS_ENTRY)
    #   \$var  → literal for Tcl    ($env(CONN_STR/VAULT_PASS/TARGET_PASS), ${c_red})
    #   \[..\] and \033 → literal for Tcl (prevents command substitution / expansion)
    # Secrets only go through $env(...), never on the command line.
    cat <<EXPECT_EOF
        log_user $log_init
        exp_internal $exp_debug
        set timeout $EXPECT_TIMEOUT

        set c_red "\033\[31m"
        set c_ylw "\033\[33m"
        set c_rst "\033\[0m"

        $spawn_line

        expect {
            -re {(?i)enter passphrase for} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} SSH passphrase requested — key not loaded in the agent\n"
                send_user "\${c_ylw}\[WARN\]\${c_rst} Load your key first: ssh-add\n"
                exit 14
            }
            -re {(?i)vault password\s*:\s*\$} {
                if {\$env(VAULT_PASS) eq ""} {
                    send_user "\n\${c_red}\[ERR\]\${c_rst} Vault password requested but none available\n"
                    send_user "\${c_ylw}\[WARN\]\${c_rst} Set up the '$VAULT_PASS_ENTRY' entry in KeePassXC or use an SSH key\n"
                    exit 10
                }
                log_user 1
                send -- "\$env(VAULT_PASS)\r"

                expect {
                    -re {(?i)vault password\s*:\s*\$} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Vault authentication failed (wrong VaultPassword)\n"
                        exit 20
                    }
                    -re {(?i)(otp|one-time password|mfa code)\s*:\s*\$} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} MFA detected — not supported by this script\n"
                        exit 21
                    }
                    -re {(?i)permission denied} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Permission denied after the vault password\n"
                        exit 22
                    }
                    -re {(?i)password\s*:\s*\$} {
                        send -- "\$env(TARGET_PASS)\r"
                    }
                    timeout {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Timeout waiting for the target prompt\n"
                        exit 23
                    }
                    eof {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Connection closed before the target prompt\n"
                        exit 24
                    }
                }
            }
            -re {(?i)password\s*:\s*\$} {
                log_user 1
                send -- "\$env(TARGET_PASS)\r"
            }
            -re {(?i)permission denied} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Permission denied (SSH key rejected?)\n"
                exit 13
            }
            timeout {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Timeout waiting for an authentication prompt\n"
                exit 11
            }
            eof {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Connection closed before authentication\n"
                exit 12
            }
        }
EXPECT_EOF
}

# =============================================================================
# Interactive SSH connection via expect (shared preamble + auto-sudo interact)
# =============================================================================
run_shell() {
    local target="$1" port="$2"

    resolve_target "$target" "$port"
    export VAULT_PASS="$R_VAULT_PASS"
    export TARGET_PASS="$R_TARGET_PASS"
    export CONN_STR="$R_CONN_STR"
    debug "Spawn: ssh -p $port $SSH_OPTS $R_CONN_STR"

    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Debug mode: passwords will be visible in the expect output"
    fi

    if [[ "${AUTO_SUDO:-1}" == 1 ]]; then
        info "Auto-sudo on (the target password answers [sudo] prompts)"
    else
        info "Auto-sudo off — manual sudo"
    fi

    local rc=0 expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    local spawn_line="spawn -noecho ssh -p $port $SSH_OPTS \$env(CONN_STR)"

    {
        emit_auth_preamble "$spawn_line"
        cat <<EXPECT_EOF

        set timeout 3
        expect {
            -re {(?i)permission denied} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Target authentication failed\n"
                exit 30
            }
            -re {(?i)password\s*:\s*\$} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Target re-prompt → wrong TARGET_PASS\n"
                exit 31
            }
            eof {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Connection closed after target auth\n"
                exit 32
            }
            timeout {}
            -re {.+} {}
        }

        set timeout -1
EXPECT_EOF
        # Conditional auto-sudo hook: AUTO_SUDO=1 answers [sudo] prompts with
        # the target password; AUTO_SUDO=0 → bare interact (manual sudo).
        if [[ "${AUTO_SUDO:-1}" == 1 ]]; then
            cat <<EXPECT_EOF
        interact -o -re {\[sudo\] [Pp]assword[^:]*:} {
            send -- "\$env(TARGET_PASS)\r"
        }
EXPECT_EOF
        else
            printf '        interact\n'
        fi
    } > "$expect_script"

    expect -f "$expect_script" || rc=$?
    rm -f "$expect_script"
    unset VAULT_PASS TARGET_PASS CONN_STR
    return $rc
}

# =============================================================================
# Expect tail shared by the non-interactive modes (exec, scp): shows the
# output of the spawned process, then propagates its exit code. Quoted
# heredoc (<<'EXPECT_EOF'): literal Tcl only, no bash expansion.
# =============================================================================
emit_noninteractive_tail() {
    cat <<'EXPECT_EOF'

        log_user 1
        set timeout -1
        expect eof
        catch wait result
        exit [lindex $result 3]
EXPECT_EOF
}

# =============================================================================
# Non-interactive execution of a remote command (like `ssh host "cmd"`).
# The command goes through $env(REMOTE_CMD): a single Tcl word, passed as is
# to the remote shell, with no Tcl substitution or backslash processing.
# =============================================================================
run_exec() {
    local target="$1" port="$2" remote_cmd="$3"

    resolve_target "$target" "$port"
    export VAULT_PASS="$R_VAULT_PASS"
    export TARGET_PASS="$R_TARGET_PASS"
    export CONN_STR="$R_CONN_STR"
    export REMOTE_CMD="$remote_cmd"
    debug "Spawn: ssh -p $port $SSH_OPTS $R_CONN_STR $remote_cmd"
    info "Running: $remote_cmd"

    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Debug mode: passwords will be visible in the expect output"
    fi

    local rc=0 expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    local spawn_line="spawn -noecho ssh -p $port $SSH_OPTS \$env(CONN_STR) \$env(REMOTE_CMD)"

    { emit_auth_preamble "$spawn_line"; emit_noninteractive_tail; } > "$expect_script"

    expect -f "$expect_script" || rc=$?
    rm -f "$expect_script"
    unset VAULT_PASS TARGET_PASS CONN_STR REMOTE_CMD
    return $rc
}

# =============================================================================
# File transfer via scp through the PSMP.
# Args = raw arguments after `cp` (scp flags + paths + one remote spec).
# =============================================================================
run_scp() {
    parse_scp_args "$@" || exit $?

    resolve_target "$PSA_REMOTE_HOST" "$PORT"
    # Rewrite the single remote spec with the CyberArk conn_str (resolved IP).
    PSA_ARGV[$PSA_REMOTE_INDEX]="${R_CONN_STR}:${PSA_REMOTE_PATH}"

    export VAULT_PASS="$R_VAULT_PASS"
    export TARGET_PASS="$R_TARGET_PASS"
    debug "Spawn: scp -P $PORT $SSH_OPTS ${PSA_ARGV[*]}"
    info "scp transfer via $R_PSMP_HOST"

    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Debug mode: passwords will be visible in the expect output"
    fi

    local rc=0 expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    # {*}$argv: Tcl expansion of the scp arguments (passed after -- below).
    local spawn_line="spawn -noecho scp -P $PORT $SSH_OPTS {*}\$argv"

    { emit_auth_preamble "$spawn_line"; emit_noninteractive_tail; } > "$expect_script"

    expect -f "$expect_script" -- "${PSA_ARGV[@]}" || rc=$?
    rm -f "$expect_script"
    unset VAULT_PASS TARGET_PASS
    return $rc
}

# =============================================================================
# psm doctor / psm setup — shared helpers
# =============================================================================
PSM_BASHRC_BEGIN='# >>> psm >>>'
PSM_BASHRC_END='# <<< psm <<<'
DOC_FAILS=0
DOC_WARNS=0

# Real path of this script (follows the /usr/local/bin/psm link to the clone)
psm_self() { readlink -f "${BASH_SOURCE[0]}"; }

detect_pkg_manager() {
    if command -v apt-get >/dev/null 2>&1; then
        echo apt
    elif command -v dnf >/dev/null 2>&1; then
        echo dnf
    fi
}

# Package that provides a command. "pinentry" stands for any terminal pinentry.
pkg_for_cmd() {
    local pm="$1" cmd="$2"
    case "$cmd" in
        expect)                echo expect ;;
        ssh|ssh-add|ssh-agent) if [[ "$pm" == dnf ]]; then echo openssh-clients; else echo openssh-client; fi ;;
        gpg)                   if [[ "$pm" == dnf ]]; then echo gnupg2; else echo gnupg; fi ;;
        keepassxc-cli)         echo keepassxc ;;
        pinentry)              if [[ "$pm" == dnf ]]; then echo pinentry; else echo pinentry-curses; fi ;;
    esac
}

# Space-separated list of the packages to install (empty when nothing is missing)
missing_packages() {
    local pm cmd pkg out=""
    pm=$(detect_pkg_manager)
    for cmd in expect ssh ssh-add ssh-agent gpg keepassxc-cli pinentry; do
        if [[ "$cmd" == pinentry ]]; then
            command -v pinentry-curses >/dev/null 2>&1 && continue
            command -v pinentry >/dev/null 2>&1 && continue
        else
            command -v "$cmd" >/dev/null 2>&1 && continue
        fi
        pkg=$(pkg_for_cmd "$pm" "$cmd")
        [[ " $out " == *" $pkg "* ]] || out+="${out:+ }$pkg"
    done
    printf '%s' "$out"
}

# Double-quoted bash literal, safe to source back
cfg_quote() {
    local v="$1"
    v="${v//\\/\\\\}"
    v="${v//\"/\\\"}"
    v="${v//\$/\\\$}"
    v="${v//\`/\\\`}"
    printf '"%s"' "$v"
}

# Same, but a path under $HOME is written as "$HOME/..." (survives a new login)
cfg_path_quote() {
    local v="$1" q
    [[ "$v" == "~/"* ]] && v="$HOME/${v#\~/}"
    if [[ "$v" == "$HOME/"* ]]; then
        q=$(cfg_quote "${v#"$HOME"/}")
        printf '"$HOME/%s' "${q#\"}"
    else
        cfg_quote "$v"
    fi
}

# Writes a minimal config file from the current variables
write_config() {
    local file="$1"
    mkdir -p "$(dirname "$file")"
    (
        umask 077
        {
            printf '# psm configuration, written by `psm setup`.\n'
            printf '# All the options are documented in config.example (psm repository).\n'
            printf 'PSMP_HOST=%s\n'       "$(cfg_quote "$PSMP_HOST")"
            printf 'VAULT_USER=%s\n'      "$(cfg_quote "$VAULT_USER")"
            printf 'KDBX_PATH=%s\n'       "$(cfg_path_quote "$KDBX_PATH")"
            printf 'KDBX_GROUP=%s\n'      "$(cfg_quote "$KDBX_GROUP")"
            printf 'GPG_MASTER_FILE=%s\n' "$(cfg_path_quote "$GPG_MASTER_FILE")"
            printf 'LDAP_USER=%s\n'       "$(cfg_quote "$LDAP_USER")"
        } > "$file"
    )
    chmod 600 "$file"
}

# Block managed in ~/.bashrc: ssh-agent detection, GPG_TTY, completion.
# The socket list matches find_agent_socket.
bashrc_block() {
    local completion
    completion="$(dirname "$(psm_self)")/completions/psm.bash"
    printf '%s\n' "$PSM_BASHRC_BEGIN"
    cat <<'EOF'
# Managed by `psm setup`: changes between the two markers are overwritten.
# ssh-agent: keep SSH_AUTH_SOCK if an agent answers on it, otherwise use the
# first agent socket that answers, otherwise start an agent.
_psm_agent_up() { SSH_AUTH_SOCK="$1" ssh-add -l >/dev/null 2>&1; [ $? -ne 2 ]; }
if command -v ssh-add >/dev/null 2>&1 && ! _psm_agent_up "${SSH_AUTH_SOCK:-}"; then
    _psm_run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for _psm_s in "$_psm_run/openssh_agent" "$_psm_run/ssh-agent.socket" \
                  "$_psm_run/psm-ssh-agent.sock" "$HOME/.ssh/psm-agent.sock"; do
        if [ -S "$_psm_s" ] && _psm_agent_up "$_psm_s"; then
            export SSH_AUTH_SOCK="$_psm_s"
            break
        fi
    done
    if ! _psm_agent_up "${SSH_AUTH_SOCK:-}"; then
        mkdir -p -m 700 "$HOME/.ssh"
        rm -f "$HOME/.ssh/psm-agent.sock"
        eval "$(ssh-agent -s -a "$HOME/.ssh/psm-agent.sock")" >/dev/null
    fi
    unset _psm_run _psm_s
fi
unset -f _psm_agent_up
# gpg-agent: tells pinentry which terminal to use
export GPG_TTY="$(tty)"
EOF
    if [[ -f "$completion" ]]; then
        printf '# Completion\n[ -r %q ] && . %q\n' "$completion" "$completion"
    fi
    printf '%s\n' "$PSM_BASHRC_END"
}

# Prints FILE with the psm block added (at the end) or replaced (in place)
bashrc_render() {
    local file="$1" block
    block=$(bashrc_block)
    if [[ -f "$file" ]] && grep -qxF -- "$PSM_BASHRC_BEGIN" "$file"; then
        if ! grep -qxF -- "$PSM_BASHRC_END" "$file"; then
            err "$file: '$PSM_BASHRC_BEGIN' without '$PSM_BASHRC_END', fix it by hand"
            return 1
        fi
        PSM_BLOCK="$block" awk -v b="$PSM_BASHRC_BEGIN" -v e="$PSM_BASHRC_END" '
            $0 == b { print ENVIRON["PSM_BLOCK"]; skip = 1; next }
            skip && $0 == e { skip = 0; next }
            !skip { print }' "$file"
    else
        if [[ -s "$file" ]]; then
            cat "$file"
            printf '\n'
        fi
        printf '%s\n' "$block"
    fi
}

# Lines outside the psm block that also set SSH_AUTH_SOCK, GPG_TTY or load the completion
bashrc_legacy_lines() {
    [[ -f "$1" ]] || return 0
    awk -v b="$PSM_BASHRC_BEGIN" -v e="$PSM_BASHRC_END" '
        $0 == b { skip = 1 }
        skip { if ($0 == e) skip = 0; next }
        /^[[:space:]]*#/ { next }
        /SSH_AUTH_SOCK=|GPG_TTY=|completions\/psm\.bash/ { printf "line %d: %s\n", NR, $0 }' "$1"
}

# Prints FILE with the lines found by bashrc_legacy_lines commented out
bashrc_comment_legacy() {
    awk -v b="$PSM_BASHRC_BEGIN" -v e="$PSM_BASHRC_END" '
        $0 == b { skip = 1 }
        skip { print; if ($0 == e) skip = 0; next }
        /^[[:space:]]*#/ { print; next }
        /SSH_AUTH_SOCK=|GPG_TTY=|completions\/psm\.bash/ { print "# (disabled by psm setup) " $0; next }
        { print }' "$1"
}

# Socket of the distro ssh-agent started by systemd (ssh-agent.socket), if any
distro_agent_socket() {
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl --user show ssh-agent.socket -P Listen 2>/dev/null | awk 'NR == 1 && NF { print $1 }'
}

systemd_user_ok() {
    command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

# First agent socket that answers (same list as the ~/.bashrc block)
find_agent_socket() {
    local run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" s rc
    for s in "$run/openssh_agent" "$run/ssh-agent.socket" \
             "$run/psm-ssh-agent.sock" "$HOME/.ssh/psm-agent.sock"; do
        [[ -S "$s" ]] || continue
        rc=0
        SSH_AUTH_SOCK="$s" ssh-add -l >/dev/null 2>&1 || rc=$?
        if (( rc != 2 )); then
            printf '%s' "$s"
            return 0
        fi
    done
}

# Key ids a GPG file is encrypted for (read from the packets, nothing is decrypted)
gpg_recipient_keyids() {
    LC_ALL=C gpg --batch --list-only --list-packets -- "$1" 2>/dev/null \
        | awk '/^:pubkey enc packet:/ { for (i = 1; i < NF; i++) if ($i == "keyid") print $(i + 1) }'
}

gpg_is_symmetric() {
    LC_ALL=C gpg --batch --list-only --list-packets -- "$1" 2>/dev/null | grep -q '^:symkey enc packet:'
}

# Ids of all the secret keys and subkeys
gpg_secret_keyids() {
    LC_ALL=C gpg --batch --with-colons --list-secret-keys 2>/dev/null \
        | awk -F: '$1 == "sec" || $1 == "ssb" { print $5 }'
}

# Usable secret keys that can encrypt: "<fingerprint><TAB><first user id>"
gpg_encrypt_keys() {
    LC_ALL=C gpg --batch --with-colons --list-secret-keys 2>/dev/null | awk -F: '
        $1 == "sec" { ok = ($2 !~ /[redni]/ && $12 ~ /E/); want_fpr = 1; uid = ""; next }
        $1 == "fpr" && want_fpr { fpr = $10; want_fpr = 0; next }
        $1 == "uid" && uid == "" && ok { uid = $10; printf "%s\t%s\n", fpr, uid }'
}

# =============================================================================
# psm doctor: read-only checks, one line each, with a fix for every problem
# =============================================================================
d_section() { printf '\n%s\n' "$*"; }
d_ok()      { printf '%s[ OK ]%s %s\n' "$C_GRN" "$C_RST" "$*"; }
d_info()    { printf '%s[INFO]%s %s\n' "$C_CYN" "$C_RST" "$*"; }
d_warn()    { printf '%s[WARN]%s %s\n' "$C_YLW" "$C_RST" "$*"; DOC_WARNS=$((DOC_WARNS + 1)); }
d_fail()    { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RST" "$*"; DOC_FAILS=$((DOC_FAILS + 1)); }
d_fix()     { printf '       fix: %s\n' "$*"; }

doctor_packages() {
    d_section "Packages"
    local missing pm
    missing=$(missing_packages)
    pm=$(detect_pkg_manager)
    if [[ -z "$missing" ]]; then
        d_ok "expect, openssh, gpg, keepassxc-cli and pinentry are installed"
    else
        d_fail "Missing packages: $missing"
        case "$pm" in
            apt) d_fix "sudo apt-get install -y $missing    (or: psm setup)" ;;
            dnf) d_fix "sudo dnf install -y $missing    (or: psm setup)" ;;
            *)   d_fix "install $missing with your package manager" ;;
        esac
    fi
    if command -v secret-tool >/dev/null 2>&1; then
        d_info "secret-tool found: the Secret Service is tried before keepassxc-cli"
    fi
}

doctor_install() {
    d_section "Install"
    local self found real
    self=$(psm_self)
    found=$(type -P psm || true)
    if [[ -z "$found" ]]; then
        d_fail "psm is not in PATH"
        d_fix "sudo ln -s '$self' /usr/local/bin/psm    (or: $self setup)"
        return 0
    fi
    real=$(readlink -f "$found")
    if [[ "$real" == "$self" && -L "$found" ]]; then
        d_ok "$found -> $self"
    elif [[ "$real" == "$self" ]]; then
        d_ok "$found"
    elif [[ -L "$found" ]]; then
        d_warn "$found points to $real, not to this copy ($self)"
        d_fix "sudo ln -sfn '$self' '$found'"
    else
        d_warn "$found is a copy: a git pull in $(dirname "$self") does not update it"
        d_fix "sudo ln -sfn '$self' '$found'"
    fi
}

doctor_config() {
    d_section "Config"
    local placeholder=0
    if [[ -z "${PSM_CONFIG_LOADED:-}" ]]; then
        d_fail "No config file (~/.config/psm/config, ~/.psmrc or \$PSM_CONFIG)"
        d_fix "psm setup"
        return 0
    fi
    d_ok "Config file: $PSM_CONFIG_LOADED"
    if [[ "$PSMP_HOST" == psmp.example.com ]]; then
        d_fail "PSMP_HOST is still the placeholder (psmp.example.com)"
        d_fix "edit $PSM_CONFIG_LOADED"
        placeholder=1
    fi
    if [[ "$VAULT_USER" == your.vault.user || "$VAULT_USER" == first.last ]]; then
        d_fail "VAULT_USER is still the placeholder ($VAULT_USER)"
        d_fix "edit $PSM_CONFIG_LOADED"
        placeholder=1
    fi
    if (( ! placeholder )); then
        d_ok "PSMP_HOST=$PSMP_HOST, VAULT_USER=$VAULT_USER"
    fi
}

doctor_kdbx() {
    d_section "KeePassXC"
    if [[ -f "$KDBX_PATH" && -r "$KDBX_PATH" ]]; then
        d_ok "Database: $KDBX_PATH"
    else
        d_fail "Database not found or not readable: $KDBX_PATH"
        d_fix "psm setup    (creates it), or set KDBX_PATH in the config"
    fi
}

doctor_gpg() {
    d_section "GnuPG"
    if ! command -v gpg >/dev/null 2>&1; then
        d_fail "gpg is not installed"
        return 0
    fi
    local f="$GPG_MASTER_FILE" mode ids secret id found=""
    if [[ ! -f "$f" ]]; then
        d_fail "Master password file not found: $f"
        d_fix "psm setup"
    else
        mode=$(stat -c %a "$f" 2>/dev/null || echo '?')
        if [[ "$mode" == 600 || "$mode" == 400 ]]; then
            d_ok "$f (mode $mode)"
        else
            d_warn "$f has mode $mode, expected 600"
            d_fix "chmod 600 $f"
        fi
        if gpg_is_symmetric "$f"; then
            d_ok "Encrypted with a passphrase (symmetric)"
        else
            ids=$(gpg_recipient_keyids "$f")
            secret=$(gpg_secret_keyids)
            for id in $ids; do
                if grep -qxF "$id" <<< "$secret"; then
                    found="$id"
                    break
                fi
            done
            if [[ -n "$found" ]]; then
                d_ok "Encrypted for one of your secret keys ($found)"
            elif [[ -z "$ids" ]]; then
                d_fail "Not a GPG encrypted file: $f"
                d_fix "move it away, then run psm setup"
            else
                d_fail "Encrypted for ${ids//$'\n'/, }, but none of your secret keys matches"
                d_fix "gpg --list-secret-keys; if the key is gone, move $f away and run psm setup"
            fi
        fi
    fi
    if [[ -n "${GPG_TTY:-}" ]]; then
        d_ok "GPG_TTY=$GPG_TTY"
    else
        d_warn "GPG_TTY is not set: pinentry may not be able to ask for the passphrase"
        d_fix "export GPG_TTY=\$(tty)    (the psm block of ~/.bashrc does it)"
    fi
    local conf="${GNUPGHOME:-$HOME/.gnupg}/gpg-agent.conf" ttl max
    ttl=$(awk '$1 == "default-cache-ttl" { v = $2 } END { print v }' "$conf" 2>/dev/null || true)
    max=$(awk '$1 == "max-cache-ttl" { v = $2 } END { print v }' "$conf" 2>/dev/null || true)
    d_info "Passphrase cache: ${ttl:-600}s after last use, ${max:-7200}s max (gpg-agent.conf)"
}

doctor_ssh_agent() {
    d_section "ssh-agent"
    local distro rc=0 sock="${SSH_AUTH_SOCK:-}"
    distro=$(distro_agent_socket)
    if [[ -f "$HOME/.config/systemd/user/ssh-agent.service" && -n "$distro" ]]; then
        d_warn "~/.config/systemd/user/ssh-agent.service hides the distro unit of the same name"
        d_fix "systemctl --user disable --now ssh-agent.service; rm ~/.config/systemd/user/ssh-agent.service; systemctl --user daemon-reload; systemctl --user restart ssh-agent.socket"
    fi
    if ! command -v ssh-add >/dev/null 2>&1; then
        d_fail "ssh-add is not installed"
        return 0
    fi
    ssh-add -l >/dev/null 2>&1 || rc=$?
    if [[ -z "$sock" ]]; then
        d_fail "SSH_AUTH_SOCK is not set"
    elif [[ ! -S "$sock" ]]; then
        d_fail "SSH_AUTH_SOCK points to a socket that does not exist: $sock"
    elif (( rc == 2 )); then
        d_fail "No agent answers on $sock"
    elif (( rc == 1 )); then
        d_warn "The agent answers on $sock, but no key is loaded"
        d_fix "ssh-add    (or: ssh-add ~/.ssh/<key registered on the PSMP>)"
        return 0
    else
        d_ok "Agent on $sock, $(ssh-add -l 2>/dev/null | wc -l) key(s) loaded"
        return 0
    fi
    if [[ -n "$distro" ]]; then
        d_fix "systemctl --user enable --now ssh-agent.socket; export SSH_AUTH_SOCK=\"$distro\""
    elif grep -qxF -- "$PSM_BASHRC_BEGIN" "$HOME/.bashrc" 2>/dev/null; then
        d_fix "open a new terminal, or run: source ~/.bashrc    (the psm block finds or starts an agent)"
    else
        d_fix "psm setup    (adds a ~/.bashrc block that finds or starts an agent)"
    fi
}

doctor_bashrc() {
    d_section "Shell (~/.bashrc)"
    local rc="$HOME/.bashrc" lines l
    if [[ -f "$rc" ]] && grep -qxF -- "$PSM_BASHRC_BEGIN" "$rc"; then
        if [[ "$(bashrc_render "$rc" 2>/dev/null)" == "$(cat "$rc")" ]]; then
            d_ok "psm block present (ssh-agent detection, GPG_TTY, completion)"
        else
            d_warn "The psm block is outdated or damaged"
            d_fix "psm setup"
        fi
    else
        d_warn "No psm block in ~/.bashrc (ssh-agent detection, GPG_TTY, completion)"
        d_fix "psm setup"
    fi
    lines=$(bashrc_legacy_lines "$rc")
    if [[ -n "$lines" ]]; then
        d_warn "Lines outside the psm block do the same job and can conflict with it:"
        while IFS= read -r l; do
            printf '       %s\n' "$l"
        done <<< "$lines"
        d_fix "psm setup    (offers to comment them out)"
    fi
}

doctor_network() {
    d_section "Network"
    if [[ "$PSMP_HOST" == psmp.example.com ]]; then
        d_info "PSMP_HOST not set, skipped"
        return 0
    fi
    if ! timeout 3 getent hosts "$PSMP_HOST" >/dev/null 2>&1; then
        d_warn "$PSMP_HOST does not resolve (VPN down? DNS?)"
        return 0
    fi
    if timeout 3 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$PSMP_HOST" "${PORT:-22}" 2>/dev/null; then
        d_ok "$PSMP_HOST:${PORT:-22} answers"
    else
        d_warn "$PSMP_HOST:${PORT:-22} does not answer (VPN down? firewall?)"
    fi
}

run_doctor() {
    if (( $# > 0 )); then
        err "Usage: psm doctor"
        return 2
    fi
    DOC_FAILS=0
    DOC_WARNS=0
    doctor_packages
    doctor_install
    doctor_config
    doctor_kdbx
    doctor_gpg
    doctor_ssh_agent
    doctor_bashrc
    doctor_network
    printf '\n'
    if (( DOC_FAILS > 0 )); then
        printf '%s%d problem(s)%s, %d warning(s)\n' "$C_RED" "$DOC_FAILS" "$C_RST" "$DOC_WARNS"
        return 1
    fi
    printf '%sNo problem found%s, %d warning(s)\n' "$C_GRN" "$C_RST" "$DOC_WARNS"
}

# =============================================================================
# psm setup: guided installation. Every step checks first, asks before
# changing anything, and does nothing when it is already done.
# =============================================================================
s_step() { printf '\n%s== %s ==%s\n' "$C_CYN" "$*" "$C_RST"; }

confirm() {
    local ans
    read -r -p "$1 [Y/n] " ans || return 1
    [[ -z "$ans" || "$ans" == [YyOo]* ]]
}

# ask_value VAR "prompt" [default] [required=1]
ask_value() {
    local __ans __def="${3:-}"
    while :; do
        read -r -p "$2${__def:+ [${__def/#$HOME/\~}]}: " __ans || return 1
        __ans="${__ans:-$__def}"
        if [[ -n "$__ans" || "${4:-0}" != 1 ]]; then
            break
        fi
        warn "A value is required"
    done
    [[ "$__ans" == "~/"* ]] && __ans="$HOME/${__ans#\~/}"
    printf -v "$1" '%s' "$__ans"
}

as_root() {
    if (( EUID == 0 )); then
        "$@"
    else
        sudo "$@"
    fi
}

setup_packages() {
    s_step "Packages"
    local missing pm
    local -a pkgs
    missing=$(missing_packages)
    if [[ -z "$missing" ]]; then
        d_ok "All the required packages are installed"
        return 0
    fi
    pm=$(detect_pkg_manager)
    if [[ -z "$pm" ]]; then
        err "No apt-get or dnf: install these packages by hand: $missing"
        return 1
    fi
    if ! confirm "Install $missing (sudo $pm)?"; then
        err "psm cannot work without: $missing"
        return 1
    fi
    read -ra pkgs <<< "$missing"
    if [[ "$pm" == apt ]]; then
        as_root apt-get update -q && as_root apt-get install -y "${pkgs[@]}" || return 1
    else
        as_root dnf install -y "${pkgs[@]}" || return 1
    fi
    missing=$(missing_packages)
    if [[ -n "$missing" ]]; then
        err "Still missing: $missing"
        return 1
    fi
    d_ok "Packages installed"
}

setup_link() {
    s_step "psm command"
    local self link="/usr/local/bin/psm" current
    self=$(psm_self)
    if [[ "$self" == "$link" ]]; then
        warn "This is the installed copy: run setup from the clone (./psm setup) to replace it with a link"
        return 0
    fi
    current=$(readlink -f "$link" 2>/dev/null || true)
    if [[ -L "$link" && "$current" == "$self" ]]; then
        d_ok "$link -> $self"
        return 0
    fi
    if [[ -L "$link" ]]; then
        warn "$link points to ${current:-a missing file}"
        confirm "Point it to $self?" || return 0
    elif [[ -e "$link" ]]; then
        warn "$link is a copy: a git pull does not update it"
        confirm "Replace it with a link to $self?" || return 0
    elif ! confirm "Create the link $link -> $self (sudo)?"; then
        warn "Skipped: add $(dirname "$self") to your PATH yourself"
        return 0
    fi
    if [[ -w "$(dirname "$link")" ]]; then
        ln -sfn "$self" "$link"
    else
        as_root ln -sfn "$self" "$link"
    fi && d_ok "$link -> $self"
}

setup_config() {
    s_step "Config"
    if [[ -n "$PSM_CONFIG_LOADED" ]]; then
        d_ok "Config file: $PSM_CONFIG_LOADED"
        if [[ "$PSMP_HOST" == psmp.example.com || "$VAULT_USER" == your.vault.user || "$VAULT_USER" == first.last ]]; then
            warn "It still holds placeholders: edit $PSM_CONFIG_LOADED"
        fi
        return 0
    fi
    local cfg="$HOME/.config/psm/config" def_host="" def_user=""
    info "No config file yet: creating $cfg"
    if [[ "$PSMP_HOST" != psmp.example.com ]]; then def_host="$PSMP_HOST"; fi
    if [[ "$VAULT_USER" != your.vault.user ]]; then def_user="$VAULT_USER"; fi
    ask_value PSMP_HOST  "PSMP address" "$def_host" 1 || return 1
    ask_value VAULT_USER "CyberArk vault user" "$def_user" 1 || return 1
    ask_value KDBX_PATH  "KeePassXC database" "$KDBX_PATH" 1 || return 1
    ask_value KDBX_GROUP "KeePassXC group of the psm entries" "$KDBX_GROUP" 1 || return 1
    ask_value LDAP_USER  "Personal LDAP/AD accounts, one entry for all servers (space-separated, optional)" "$LDAP_USER" || return 1
    write_config "$cfg"
    PSM_CONFIG_LOADED="$cfg"
    d_ok "Written: $cfg"
}

setup_ssh_agent() {
    s_step "ssh-agent"
    local rc=0 distro sock keys
    local unit_dir="$HOME/.config/systemd/user"
    distro=$(distro_agent_socket)
    if [[ -f "$unit_dir/ssh-agent.service" && -n "$distro" ]]; then
        warn "$unit_dir/ssh-agent.service hides the distro unit of the same name (older WSL2 guide)"
        if confirm "Disable and remove it?"; then
            systemctl --user disable --now ssh-agent.service 2>/dev/null || true
            rm -f "$unit_dir/ssh-agent.service"
            systemctl --user daemon-reload || true
            systemctl --user restart ssh-agent.socket 2>/dev/null || true
        fi
    fi

    ssh-add -l >/dev/null 2>&1 || rc=$?
    if (( rc != 2 )); then
        d_ok "Agent on $SSH_AUTH_SOCK"
    else
        sock=$(find_agent_socket)
        if [[ -n "$sock" ]]; then
            d_ok "Agent found on $sock (new shells use it through the ~/.bashrc block)"
            export SSH_AUTH_SOCK="$sock"
        elif [[ -n "$distro" ]] && systemd_user_ok; then
            if confirm "Enable the distro agent (systemctl --user enable --now ssh-agent.socket)?"; then
                systemctl --user enable --now ssh-agent.socket && export SSH_AUTH_SOCK="$distro"
            fi
        elif systemd_user_ok; then
            if confirm "Create a systemd user service for ssh-agent (psm-ssh-agent.service)?"; then
                mkdir -p "$unit_dir"
                cat > "$unit_dir/psm-ssh-agent.service" <<'EOF'
[Unit]
Description=SSH authentication agent (psm)

[Service]
Type=simple
Environment=SSH_AUTH_SOCK=%t/psm-ssh-agent.sock
ExecStart=/usr/bin/ssh-agent -D -a $SSH_AUTH_SOCK

[Install]
WantedBy=default.target
EOF
                systemctl --user daemon-reload \
                    && systemctl --user enable --now psm-ssh-agent.service \
                    && export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/psm-ssh-agent.sock"
            fi
        else
            # Same agent as the one the ~/.bashrc block starts in new shells
            info "No systemd user session: starting an agent on ~/.ssh/psm-agent.sock"
            mkdir -p -m 700 "$HOME/.ssh"
            rm -f "$HOME/.ssh/psm-agent.sock"
            local agent_env
            if agent_env=$(ssh-agent -s -a "$HOME/.ssh/psm-agent.sock"); then
                eval "$agent_env" >/dev/null
            else
                warn "ssh-agent failed to start"
            fi
        fi
        rc=0
        ssh-add -l >/dev/null 2>&1 || rc=$?
    fi

    if (( rc == 0 )); then
        d_ok "$(ssh-add -l 2>/dev/null | wc -l) key(s) loaded"
    elif (( rc == 1 )); then
        keys=$(find "$HOME/.ssh" -maxdepth 1 -name 'id_*' ! -name '*.pub' 2>/dev/null || true)
        if [[ -n "$keys" ]]; then
            info "Keys in ~/.ssh: $(tr '\n' ' ' <<< "$keys")"
            if confirm "Load them now (ssh-add)?"; then
                ssh-add || warn "ssh-add failed"
            fi
        else
            info "No key in ~/.ssh: psm will use the vault password (KeePassXC entry $VAULT_PASS_ENTRY)"
        fi
    fi
}

setup_gpg() {
    s_step "GnuPG"
    local keys home conf pe
    local -a add=()
    keys=$(gpg_encrypt_keys)
    if [[ -n "$keys" ]]; then
        d_ok "$(wc -l <<< "$keys") GPG key(s) that can encrypt"
    else
        warn "No GPG key that can encrypt in your keyring"
        if confirm "Create one now (gpg --full-generate-key)?"; then
            gpg --full-generate-key || true
        fi
        [[ -n "$(gpg_encrypt_keys)" ]] || warn "Without a GPG key, the master password file cannot be created"
    fi

    home="${GNUPGHOME:-$HOME/.gnupg}"
    conf="$home/gpg-agent.conf"
    # Terminal pinentry: WSL, or no graphical session
    if [[ -n "${WSL_DISTRO_NAME:-}" || ( -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ) ]] \
       && ! grep -q '^[[:space:]]*pinentry-program' "$conf" 2>/dev/null; then
        pe=$(command -v pinentry-curses || true)
        [[ -n "$pe" ]] && add+=("pinentry-program $pe")
    fi
    grep -q '^[[:space:]]*default-cache-ttl' "$conf" 2>/dev/null || add+=("default-cache-ttl 28800")
    grep -q '^[[:space:]]*max-cache-ttl' "$conf" 2>/dev/null || add+=("max-cache-ttl 86400")
    if (( ${#add[@]} == 0 )); then
        d_ok "gpg-agent.conf: nothing to add"
        return 0
    fi
    info "Suggested gpg-agent settings (terminal pinentry, passphrase cached 8 h, 24 h max):"
    printf '         %s\n' "${add[@]}" >&2
    if confirm "Add them to $conf?"; then
        mkdir -p -m 700 "$home"
        printf '%s\n' "${add[@]}" >> "$conf"
        chmod 600 "$conf"
        gpgconf --reload gpg-agent 2>/dev/null || true
        d_ok "gpg-agent.conf updated"
    fi
}

# Runs keepassxc-cli with the master password on stdin: $1 if set, otherwise
# decrypted from GPG_MASTER_FILE. The password never goes on a command line.
kdbx_cmd() {
    local pw="$1"
    shift
    if [[ -n "$pw" ]]; then
        printf '%s' "$pw" | keepassxc-cli "$@"
    else
        gpg -qd "$GPG_MASTER_FILE" 2>/dev/null | keepassxc-cli "$@"
    fi
}

setup_master() {
    s_step "KeePassXC database and master password"
    local pw="" pw2 keys n choice fpr uid i
    if [[ -f "$KDBX_PATH" ]]; then
        d_ok "Database: $KDBX_PATH"
    else
        if ! confirm "Create the KeePassXC database $KDBX_PATH?"; then
            warn "Skipped"
            return 0
        fi
        while :; do
            read -rs -p "New master password: " pw; printf '\n' >&2
            read -rs -p "Same again: " pw2; printf '\n' >&2
            [[ -n "$pw" && "$pw" == "$pw2" ]] && break
            warn "Empty or different, try again"
        done
        pw2=""
        mkdir -p "$(dirname "$KDBX_PATH")"
        if ! printf '%s\n%s\n' "$pw" "$pw" | keepassxc-cli db-create -q -p "$KDBX_PATH" >/dev/null 2>&1; then
            err "keepassxc-cli db-create failed"
            return 1
        fi
        d_ok "Database created: $KDBX_PATH"
    fi

    if [[ -f "$GPG_MASTER_FILE" ]]; then
        d_ok "Master password file: $GPG_MASTER_FILE (psm doctor checks its key)"
    else
        keys=$(gpg_encrypt_keys)
        if [[ -z "$keys" ]]; then
            warn "No GPG key: $GPG_MASTER_FILE not created"
            return 0
        fi
        confirm "Store the master password in $GPG_MASTER_FILE, encrypted with your GPG key?" || return 0
        if [[ -z "$pw" ]]; then
            for i in 1 2 3; do
                read -rs -p "Master password of $KDBX_PATH: " pw; printf '\n' >&2
                printf '%s' "$pw" | keepassxc-cli ls -q "$KDBX_PATH" >/dev/null 2>&1 && break
                warn "Wrong password"
                pw=""
            done
            if [[ -z "$pw" ]]; then
                err "Giving up after 3 attempts"
                return 1
            fi
        fi
        n=$(wc -l <<< "$keys")
        choice=1
        if (( n > 1 )); then
            i=0
            while IFS=$'\t' read -r fpr uid; do
                i=$((i + 1))
                printf '  %d) %s  (%s)\n' "$i" "$uid" "${fpr: -16}" >&2
            done <<< "$keys"
            while :; do
                read -r -p "GPG key to use [1]: " choice
                choice="${choice:-1}"
                [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= n )) && break
            done
        fi
        IFS=$'\t' read -r fpr uid <<< "$(sed -n "${choice}p" <<< "$keys")"
        # --trust-model always: the recipient is one of the user's own secret keys
        if (umask 077; printf '%s' "$pw" \
                | gpg --batch --yes -q --trust-model always --encrypt --recipient "$fpr" -o "$GPG_MASTER_FILE"); then
            chmod 600 "$GPG_MASTER_FILE"
            d_ok "Written: $GPG_MASTER_FILE (for $uid)"
        else
            err "gpg --encrypt failed"
            pw=""
            return 1
        fi
    fi

    if kdbx_cmd "$pw" ls -q "$KDBX_PATH" "$KDBX_GROUP" >/dev/null 2>&1; then
        d_ok "Group $KDBX_GROUP found in the database"
    elif confirm "Create the group $KDBX_GROUP in the database?"; then
        if kdbx_cmd "$pw" mkdir -q "$KDBX_PATH" "$KDBX_GROUP" >/dev/null 2>&1; then
            d_ok "Group $KDBX_GROUP created"
        else
            err "Could not create the group $KDBX_GROUP"
        fi
    fi
    pw=""
}

setup_bashrc() {
    s_step "~/.bashrc"
    local rc="$HOME/.bashrc" new legacy backed_up=0
    new=$(bashrc_render "$rc") || return 1
    if [[ -f "$rc" && "$new" == "$(cat "$rc")" ]]; then
        d_ok "psm block up to date"
    else
        info "psm block for $rc:"
        bashrc_block | sed 's/^/         /' >&2
        if confirm "Write it?"; then
            if [[ -f "$rc" ]]; then
                cp -p "$rc" "$rc.psm-backup"
                backed_up=1
            fi
            printf '%s\n' "$new" > "$rc"
            if (( backed_up )); then
                d_ok "Written (previous version: $rc.psm-backup)"
            else
                d_ok "Written: $rc"
            fi
        fi
    fi

    legacy=$(bashrc_legacy_lines "$rc")
    [[ -n "$legacy" ]] || return 0
    warn "These lines outside the psm block do the same job and can conflict with it:"
    sed 's/^/         /' <<< "$legacy" >&2
    confirm "Comment them out?" || return 0
    new=$(bashrc_comment_legacy "$rc")
    if ! bash -n <<< "$new" 2>/dev/null; then
        warn "Commenting them out would break the syntax of $rc: edit it by hand"
        return 0
    fi
    (( backed_up )) || cp -p "$rc" "$rc.psm-backup"
    printf '%s\n' "$new" > "$rc"
    d_ok "Commented out (previous version: $rc.psm-backup)"
}

run_setup() {
    if (( $# > 0 )); then
        err "Usage: psm setup"
        return 2
    fi
    if [[ ! -t 0 ]]; then
        err "psm setup asks questions: run it from a terminal"
        return 2
    fi
    export GPG_TTY="${GPG_TTY:-$(tty)}"
    info "Each step checks first and asks before changing anything."
    setup_packages || return 1
    setup_link
    setup_config || return 1
    setup_ssh_agent
    setup_gpg
    setup_master || true
    setup_bashrc || true
    s_step "psm doctor"
    run_doctor || true
    printf '\n'
    info "Open a new terminal (or run: source ~/.bashrc) to load the ~/.bashrc changes"
}

# =============================================================================
# Entry point
# =============================================================================
main() {
    DEBUG=0
    PORT=22
    LIST_ONLY=0

    while getopts ":dlp:v:hS" opt; do
        case "$opt" in
            d) DEBUG=1 ;;
            S) AUTO_SUDO=0 ;;
            l) LIST_ONLY=1 ;;
            p) PORT="$OPTARG" ;;
            v) VAULT_USER="$OPTARG" ;;
            h) usage; exit 0 ;;
            \?) err "Unknown option: -$OPTARG"; usage; exit 2 ;;
            :)  err "Option -$OPTARG requires an argument"; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))

    # Leftover secrets detection (cleanup of a previous session failed)
    if [[ -n "${VAULT_PASS:-}" || -n "${TARGET_PASS:-}" ]]; then
        warn "Leftover secrets found in the environment (previous session did not exit cleanly) — purging"
        unset VAULT_PASS TARGET_PASS
    fi

    # doctor and setup run before check_deps: they report or install the
    # missing dependencies. Called in a `||` list, so `set -e` does not
    # stop them at the first failed check.
    local sub_rc=0
    case "${1:-}" in
        doctor) shift; run_doctor "$@" || sub_rc=$?; exit "$sub_rc" ;;
        setup)  shift; run_setup "$@"  || sub_rc=$?; exit "$sub_rc" ;;
    esac

    check_deps

    if (( LIST_ONLY == 1 )); then
        list_targets
        exit $?
    fi

    if (( $# < 1 )); then
        err "Missing argument: <targetuser@targethost> [command]"
        usage
        exit 2
    fi

    # Port validation
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
        err "Invalid port: $PORT"
        exit 2
    fi

    if [[ "$1" == "cp" ]]; then
        shift
        if (( $# < 2 )); then
            err "Usage: psm cp [flags] SRC... DST"
            exit 2
        fi
        run_scp "$@"
        exit $?
    fi

    local target="$1"; shift
    if (( $# > 0 )); then
        run_exec "$target" "$PORT" "$*"       # psm host "cmd..."
    else
        run_shell "$target" "$PORT"           # psm host  (interactive shell)
    fi
}

# Only run main when the script is executed directly (not when sourced by the tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
