#!/usr/bin/env bash
# psm — SSH via CyberArk PSMP avec récupération automatique des credentials
#       depuis KeePassXC (Secret Service API, fallback keepassxc-cli).
#
# Flow : ssh vaultuser@targetuser@targethost@psmphost
#   Mode clé SSH : auth vault transparente (ssh-agent) → "Password:" target
#   Mode password : "Vault Password:" → "Password:" target
#   → Shell interactif sur le serveur cible

set -euo pipefail

# =============================================================================
# CONFIG — le script cherche un fichier de config dans cet ordre :
#   1. $PSM_CONFIG (si défini)
#   2. ~/.config/psm/config
#   3. ~/.psmrc
# Le premier trouvé est sourcé. Si aucun, les défauts ci-dessous s'appliquent.
#
# Précédence (selon comment tu écris le fichier de config) :
#   - `VAULT_USER="foo"`              → config surcharge l'environnement
#   - `: "${VAULT_USER:=foo}"`        → environnement garde la priorité
# =============================================================================
PSM_CONFIG="${PSM_CONFIG:-}"
for _candidate in "$PSM_CONFIG" "$HOME/.config/psm/config" "$HOME/.psmrc"; do
    if [[ -n "$_candidate" && -f "$_candidate" ]]; then
        # shellcheck source=/dev/null
        source "$_candidate"
        break
    fi
done
unset _candidate

PSMP_HOST="${PSMP_HOST:-psmp.example.com}"
VAULT_USER="${VAULT_USER:-ton.vault.user}"
KDBX_PATH="${KDBX_PATH:-$HOME/Passwords.kdbx}"
KDBX_GROUP="${KDBX_GROUP:-PSM}"
VAULT_PASS_ENTRY="${VAULT_PASS_ENTRY:-VaultPassword}"
GPG_MASTER_FILE="${GPG_MASTER_FILE:-$HOME/.psm-master.gpg}"
LDAP_USER="${LDAP_USER:-}"  # liste de users LDAP/AD (séparés par espaces), ex: "john.doe jane.smith"
SSH_OPTS="${SSH_OPTS:--o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o LogLevel=ERROR}"
EXPECT_TIMEOUT="${EXPECT_TIMEOUT:-30}"

# =============================================================================
# Couleurs (désactivées si stderr n'est pas un terminal)
# =============================================================================
if [[ -t 2 ]]; then
    C_RED=$'\033[31m'
    C_GRN=$'\033[32m'
    C_YLW=$'\033[33m'
    C_CYN=$'\033[36m'
    C_RST=$'\033[0m'
else
    C_RED='' C_GRN='' C_YLW='' C_CYN='' C_RST=''
fi

err()   { printf '%s[ERR]%s  %s\n'  "$C_RED" "$C_RST" "$*" >&2; }
warn()  { printf '%s[WARN]%s %s\n'  "$C_YLW" "$C_RST" "$*" >&2; }
info()  { printf '%s[INFO]%s %s\n'  "$C_CYN" "$C_RST" "$*" >&2; }
debug() { [[ "${DEBUG:-0}" == 1 ]] && printf '%s[DBG]%s  %s\n' "$C_GRN" "$C_RST" "$*" >&2 || true; }

# =============================================================================
# Aide
# =============================================================================
usage() {
    cat <<EOF
Usage: psm [options] <targetuser@targethost|targethost>

Connecte à un serveur cible via le proxy CyberArk PSMP.
Récupère les mots de passe (vault + target) depuis KeePassXC.

Si la cible est un hostname seul (ex: 'srv-prod01'), l'user est extrait
depuis le champ 'User' de ~/.ssh/config pour ce host.

Options:
  -d          Debug mode (affiche tous les échanges expect)
  -l          Liste les targets disponibles dans KeePassXC
  -p PORT     Port SSH du PSMP (défaut: 22)
  -v VUSER    Override du vault user (défaut: \$VAULT_USER)
  -h          Affiche cette aide

Exemples:
  psm admin@srv-prod01            # syntaxe user@host explicite
  psm srv-prod01                  # user extrait de ~/.ssh/config
  psm -d root@switch-core01
  psm -p 2222 admin@srv-prod01
  psm -l

Configuration courante:
  PSMP_HOST          = $PSMP_HOST
  VAULT_USER         = $VAULT_USER
  KDBX_GROUP         = $KDBX_GROUP
  VAULT_PASS_ENTRY   = $VAULT_PASS_ENTRY
  LDAP_USER          = ${LDAP_USER:-<non défini>}

Variables d'environnement supportées:
  PSMP_HOST, VAULT_USER, KDBX_PATH, KDBX_GROUP,
  VAULT_PASS_ENTRY, GPG_MASTER_FILE, LDAP_USER,
  SSH_OPTS, EXPECT_TIMEOUT
EOF
}

# =============================================================================
# Vérification des dépendances
# =============================================================================
check_deps() {
    local missing=()
    command -v expect >/dev/null 2>&1 || missing+=("expect")
    command -v ssh    >/dev/null 2>&1 || missing+=("ssh")

    if (( ${#missing[@]} > 0 )); then
        err "Dépendances manquantes :"
        for m in "${missing[@]}"; do err "  - $m"; done
        err "Installation Debian/Ubuntu : apt install expect openssh-client"
        err "Installation RHEL/Fedora   : dnf install expect openssh-clients"
        exit 2
    fi

    # Sources de credentials : au moins une requise
    local has_secret_tool=0 has_keepassxc=0
    command -v secret-tool   >/dev/null 2>&1 && has_secret_tool=1
    command -v keepassxc-cli >/dev/null 2>&1 && has_keepassxc=1

    if (( !has_secret_tool && !has_keepassxc )); then
        err "Aucune source de credentials disponible"
        err "Installe au moins un des outils suivants :"
        err "  - secret-tool   (libsecret-tools) : KeePassXC GUI + Secret Service"
        err "  - keepassxc-cli                    : ligne de commande + GPG"
        exit 2
    fi

    (( has_secret_tool )) || debug "secret-tool absent : mode Secret Service désactivé"
    (( has_keepassxc ))   || debug "keepassxc-cli absent : mode CLI désactivé"
}

# =============================================================================
# Récupération d'un mot de passe : Secret Service → fallback keepassxc-cli
# =============================================================================
fetch_password() {
    local entry="$1"
    local quiet="${2:-0}"
    local pass=""

    # 1. Secret Service (KeePassXC GUI déverrouillé + intégration activée)
    if command -v secret-tool >/dev/null 2>&1; then
        if pass=$(secret-tool lookup Title "$entry" 2>/dev/null) && [[ -n "$pass" ]]; then
            debug "Mot de passe récupéré via secret-tool pour '$entry'"
            printf '%s' "$pass"
            return 0
        fi
        debug "secret-tool a échoué pour '$entry', tentative keepassxc-cli"
    fi

    # 2. keepassxc-cli avec master password déchiffré par GPG (gpg-agent cache la passphrase)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        if [[ -f "$GPG_MASTER_FILE" ]] && command -v gpg >/dev/null 2>&1; then
            debug "Déchiffrement du master password via GPG ($GPG_MASTER_FILE)"
            if pass=$(gpg -qd "$GPG_MASTER_FILE" 2>/dev/null \
                       | keepassxc-cli show -qsa Password "$KDBX_PATH" "$KDBX_GROUP/$entry" 2>/dev/null) \
               && [[ -n "$pass" ]]; then
                debug "Mot de passe récupéré via keepassxc-cli + GPG pour '$entry'"
                printf '%s' "$pass"
                return 0
            fi
        fi

        # 3. Fallback interactif — uniquement si GPG n'est PAS configuré
        # (si GPG_MASTER_FILE existe, on considère la base déchiffrable : un
        # échec signifie "entrée introuvable", pas "base inaccessible" — donc
        # pas besoin de re-prompter le master password interactivement)
        # Retrait du flag -q qui supprimait le prompt master password.
        if (( ! quiet )) && [[ ! -f "$GPG_MASTER_FILE" ]]; then
            debug "Fallback keepassxc-cli interactif pour '$entry'"
            if pass=$(keepassxc-cli show -sa Password "$KDBX_PATH" "$KDBX_GROUP/$entry") \
               && [[ -n "$pass" ]]; then
                debug "Mot de passe récupéré via keepassxc-cli pour '$entry'"
                printf '%s' "$pass"
                return 0
            fi
        fi
    fi

    if (( quiet )); then
        debug "Lookup silencieux échoué pour '$entry'"
        return 1
    fi

    err "Impossible de récupérer le mot de passe pour : $entry"
    err "Vérifie que :"
    err "  - KeePassXC est ouvert et déverrouillé (mode Secret Service)"
    err "  - Ou ~/.psm-master.gpg existe (mode keepassxc-cli + GPG)"
    err "  - Le groupe '$KDBX_GROUP' contient l'entrée '$entry'"
    return 1
}

# =============================================================================
# Liste des targets disponibles depuis KeePassXC
# =============================================================================
list_targets() {
    info "Targets disponibles dans le groupe '$KDBX_GROUP' :"

    # secret-tool search retourne les entrées avec un attribut donné
    # On cherche celles ayant un attribut xdg:schema (toutes les entrées KeePassXC)
    # puis on filtre par format user@host
    local found=0
    if command -v secret-tool >/dev/null 2>&1; then
        while IFS= read -r title; do
            if [[ "$title" == *@* && "$title" != "$VAULT_PASS_ENTRY" ]]; then
                printf '  %s\n' "$title"
                found=1
            fi
        done < <(secret-tool search --all xdg:schema org.freedesktop.Secret.Generic 2>/dev/null | \
                 awk -F' = ' '/^attribute\.Title/ {print $2}' | sort -u)
    fi
    if (( found )); then
        return 0
    fi

    # fallback keepassxc-cli (GPG d'abord, puis interactif)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        local entries=""
        if [[ -f "$GPG_MASTER_FILE" ]] && command -v gpg >/dev/null 2>&1; then
            debug "Liste via keepassxc-cli + GPG"
            entries=$(gpg -qd "$GPG_MASTER_FILE" 2>/dev/null \
                      | keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null) || true
        fi
        if [[ -z "$entries" ]]; then
            warn "Fallback keepassxc-cli interactif (master password requis)"
            entries=$(keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null) || true
        fi
        if [[ -n "$entries" ]]; then
            printf '%s\n' "$entries" | grep -v '^VaultPassword' | sed 's/^/  /'
            return 0
        fi
    fi

    err "Aucune source disponible pour lister les targets"
    return 1
}

# =============================================================================
# Connexion SSH via expect
# =============================================================================
connect() {
    local target="$1" port="$2"
    local target_user="" target_host=""

    # Parse target : 'user@host' ou 'host' seul (user sera extrait de ~/.ssh/config)
    if [[ "$target" == *@* ]]; then
        target_user="${target%@*}"
        target_host="${target#*@}"
        if [[ -z "$target_user" || -z "$target_host" ]]; then
            err "Format invalide : '$target' (attendu: user@host ou host)"
            exit 2
        fi
    else
        target_host="$target"
    fi

    # Résolution via ssh -G : récupère hostname ET user (si pas spécifié)
    local original_host="$target_host"
    local ssh_g_output
    debug "Résolution ssh -G $target_host"
    local ssh_g_stderr="/dev/null"
    [[ "${DEBUG:-0}" == 1 ]] && ssh_g_stderr="/dev/stderr"
    if ! ssh_g_output=$(ssh -G "$target_host" 2>"$ssh_g_stderr"); then
        err "ssh -G a échoué pour '$target_host' — vérifie ~/.ssh/config"
        exit 2
    fi

    local resolved
    resolved=$(awk '/^hostname / {print $2}' <<< "$ssh_g_output")
    [[ -n "$resolved" ]] && target_host="$resolved"

    # Si user non spécifié dans la cmdline, l'extraire depuis ssh -G
    if [[ -z "$target_user" ]]; then
        target_user=$(awk '/^user / {print $2}' <<< "$ssh_g_output")
        if [[ -z "$target_user" ]]; then
            err "Pas d'user spécifié pour '$original_host'"
            err "Utilise la syntaxe 'user@host' ou ajoute 'User xxx' dans ~/.ssh/config"
            exit 2
        fi
        debug "User extrait de ~/.ssh/config : $target_user"
    fi
    # 2. /etc/hosts + DNS (timeout 2s pour éviter les blocages)
    if [[ ! "$target_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        debug "Résolution DNS : getent hosts $target_host (timeout 2s)"
        local ip
        ip=$(timeout 2 getent hosts "$target_host" 2>/dev/null | awk '{print $1}') || true
        if [[ -n "$ip" ]]; then
            target_host="$ip"
        else
            debug "DNS non résolu, hostname passé tel quel"
        fi
    fi
    if [[ "$target_host" != "$original_host" ]]; then
        debug "Résolution : $original_host → $target_host"
        info "Cible : $target_user @ $original_host → $target_host (via $PSMP_HOST:$port)"
    else
        info "Cible : $target_user @ $target_host (via $PSMP_HOST:$port)"
    fi

    # Vault password : inutile si auth par clé SSH (agent actif avec clés chargées)
    local vault_pass="" target_pass=""
    local original_target="${target_user}@${original_host}"
    local resolved_target="${target_user}@${target_host}"
    debug "Vérification ssh-agent"
    if ssh-add -l >/dev/null 2>&1; then
        info "Mode clé SSH (agent actif, clés chargées)"
    else
        debug "Pas de clé SSH, fetch vault password"
        vault_pass=$(fetch_password "$VAULT_PASS_ENTRY" 1) || true
        if [[ -n "$vault_pass" ]]; then
            debug "Vault password récupéré — mode password"
        else
            warn "Pas de vault password et ssh-agent sans clé chargée"
            warn "Si le PSMP demande un vault password, la connexion échouera"
        fi
    fi

    # Target password : obligatoire
    # Ordre de lookup — dépend de si target_user est un compte LDAP connu (LDAP_USER)
    #   LDAP connu     : user → user@ip → user@hostname  (entrée unique, même passwd partout)
    #   Compte service : user@ip → user@hostname → user  (spécifique avant générique)
    local is_ldap=0 u
    for u in $LDAP_USER; do
        if [[ "$target_user" == "$u" ]]; then
            is_ldap=1
            break
        fi
    done

    local lookup_names=()
    if (( is_ldap )); then
        debug "User '$target_user' identifié comme compte LDAP (via LDAP_USER)"
        lookup_names=("$target_user")
        if [[ "$resolved_target" != "$original_target" ]]; then
            lookup_names+=("$resolved_target" "$original_target")
        else
            lookup_names+=("$original_target")
        fi
    else
        if [[ "$resolved_target" != "$original_target" ]]; then
            lookup_names=("$resolved_target" "$original_target" "$target_user")
        else
            lookup_names=("$original_target" "$target_user")
        fi
    fi

    local found_name=""
    for name in "${lookup_names[@]}"; do
        debug "Fetch target password pour '$name'"
        target_pass=$(fetch_password "$name" 1) || true
        if [[ -n "$target_pass" ]]; then
            found_name="$name"
            break
        fi
        debug "Lookup '$name' échoué"
    done

    if [[ -z "$target_pass" ]]; then
        err "Impossible de récupérer le target password pour '$target_user'"
        err "Noms essayés dans KeePassXC (aucun trouvé) :"
        for name in "${lookup_names[@]}"; do
            err "  - $KDBX_GROUP/$name"
        done
        err "Crée une entrée avec un de ces Titles dans le groupe '$KDBX_GROUP'"
        exit 3
    fi
    debug "Target password OK (entrée KeePassXC : $found_name)"

    # Construction de la string de connexion CyberArk (IP résolue pour le PSMP)
    local conn_str="${VAULT_USER}@${target_user}@${target_host}@${PSMP_HOST}"
    debug "Spawn: ssh -p $port $SSH_OPTS $conn_str"

    # Export des passwords vers expect via env (jamais sur la cmdline)
    export VAULT_PASS="$vault_pass"
    export TARGET_PASS="$target_pass"
    unset vault_pass target_pass

    # Mode debug expect
    local log_init=0 exp_debug=0
    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Mode debug : les mots de passe seront visibles dans la sortie expect"
        log_init=1
        exp_debug=1
    fi

    # =========================================================================
    # Script expect — séquence d'auth keyboard-interactive
    # =========================================================================
    # Script expect écrit dans un fichier temp pour garder stdin connecté
    # au terminal (sinon interact reçoit eof immédiatement)
    local rc=0
    local expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    # Heredoc NON quoté (<<EXPECT_EOF) : bash expand $var, Tcl reçoit les valeurs.
    # Convention d'escaping :
    #   $var        → expandé par bash   (config: $port, $SSH_OPTS, $conn_str, ...)
    #   \$var       → littéral pour Tcl  ($env(...), ${c_red}, ...)
    #   \[...\]     → littéral pour Tcl  (évite la command substitution sur les crochets)
    cat > "$expect_script" <<EXPECT_EOF
        # En debug, on voit tout ; sinon on masque le banner initial
        log_user $log_init
        exp_internal $exp_debug
        set timeout $EXPECT_TIMEOUT

        # Couleurs pour les messages (définies en Tcl pour éviter que les
        # crochets ANSI ne déclenchent la command substitution Tcl)
        set c_red "\033\[31m"
        set c_ylw "\033\[33m"
        set c_rst "\033\[0m"

        # Lancement de la connexion SSH vers le PSMP
        spawn -noecho ssh -p $port $SSH_OPTS $conn_str

        # ---------------------------------------------------------------------
        # Étape 1 : Vault Password OU directement Target Password
        # (si auth vault par clé SSH, le prompt vault n'apparaît pas)
        # ---------------------------------------------------------------------
        expect {
            -re {(?i)vault password\s*:\s*\$} {
                # Mode password — vault prompt détecté
                if {\$env(VAULT_PASS) eq ""} {
                    send_user "\n\${c_red}\[ERR\]\${c_rst} Vault password demandé mais aucun disponible\n"
                    send_user "\${c_ylw}\[WARN\]\${c_rst} Configure l'entrée '$VAULT_PASS_ENTRY' dans KeePassXC ou utilise une clé SSH\n"
                    exit 10
                }
                log_user 1
                send -- "\$env(VAULT_PASS)\r"

                # Attendre le prompt target (ou erreur vault)
                expect {
                    -re {(?i)vault password\s*:\s*\$} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Authentification vault échouée (mauvais VaultPassword)\n"
                        exit 20
                    }
                    -re {(?i)(otp|one-time password|mfa code)\s*:\s*\$} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} MFA détecté — non supporté par ce script\n"
                        exit 21
                    }
                    -re {(?i)permission denied} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Permission refusée après vault password\n"
                        exit 22
                    }
                    -re {(?i)password\s*:\s*\$} {
                        send -- "\$env(TARGET_PASS)\r"
                    }
                    timeout {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Timeout en attendant le prompt target\n"
                        exit 23
                    }
                    eof {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Connexion fermée avant prompt target\n"
                        exit 24
                    }
                }
            }
            -re {(?i)password\s*:\s*\$} {
                # Mode clé SSH — vault auth transparente, c'est le prompt target
                log_user 1
                send -- "\$env(TARGET_PASS)\r"
            }
            -re {(?i)permission denied} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Permission refusée (clé SSH rejetée ?)\n"
                exit 13
            }
            timeout {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Timeout en attendant un prompt d'authentification\n"
                exit 11
            }
            eof {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Connexion fermée avant authentification\n"
                exit 12
            }
        }

        # ---------------------------------------------------------------------
        # Étape 3 : vérif rapide d'erreur auth target puis interact
        # Timeout court (3s) : juste assez pour détecter un rejet immédiat,
        # puis on bascule en interactif sans bloquer l'utilisateur.
        # ---------------------------------------------------------------------
        set timeout 3
        expect {
            -re {(?i)permission denied} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Authentification target échouée\n"
                exit 30
            }
            -re {(?i)password\s*:\s*\$} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Re-prompt target → mauvais TARGET_PASS\n"
                exit 31
            }
            eof {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Connexion fermée après auth target\n"
                exit 32
            }
            timeout {}
            -re {.+} {}
        }

        # Bascule en mode interactif : l'utilisateur reprend le contrôle
        # Ctrl-C et autres signaux sont transmis au shell distant
        # Auto-sudo : intercepte les prompts [sudo] et envoie TARGET_PASS
        set timeout -1
        interact -o -re {\[sudo\] [Pp]assword[^:]*:} {
            send -- "\$env(TARGET_PASS)\r"
        }
EXPECT_EOF

    expect -f "$expect_script" || rc=$?
    rm -f "$expect_script"

    # Nettoyage immédiat des secrets en mémoire (exécuté même si expect échoue)
    unset VAULT_PASS TARGET_PASS

    return $rc
}

# =============================================================================
# Parsing CLI
# =============================================================================
DEBUG=0
PORT=22
LIST_ONLY=0

while getopts ":dlp:v:h" opt; do
    case "$opt" in
        d) DEBUG=1 ;;
        l) LIST_ONLY=1 ;;
        p) PORT="$OPTARG" ;;
        v) VAULT_USER="$OPTARG" ;;
        h) usage; exit 0 ;;
        \?) err "Option inconnue : -$OPTARG"; usage; exit 2 ;;
        :)  err "Option -$OPTARG requiert un argument"; exit 2 ;;
    esac
done
shift $((OPTIND - 1))

# Détection de secrets résiduels (nettoyage raté d'une session précédente)
if [[ -n "${VAULT_PASS:-}" || -n "${TARGET_PASS:-}" ]]; then
    warn "VAULT_PASS et/ou TARGET_PASS déjà présentes dans l'environnement"
    warn "Un nettoyage n'a pas été effectué lors d'une exécution précédente"
    unset VAULT_PASS TARGET_PASS
    warn "Variables purgées"
fi

check_deps

if (( LIST_ONLY == 1 )); then
    list_targets
    exit $?
fi

if (( $# != 1 )); then
    err "Argument manquant : <targetuser@targethost>"
    usage
    exit 2
fi

# Validation port
if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
    err "Port invalide : $PORT"
    exit 2
fi

connect "$1" "$PORT"
