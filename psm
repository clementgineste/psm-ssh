#!/usr/bin/env bash
# psm — SSH through a CyberArk PSMP with automatic credential retrieval
#       from KeePassXC (Secret Service API, keepassxc-cli fallback).
#
# Flow: ssh vaultuser@targetuser@targethost@psmphost
#   SSH key mode : transparent vault auth (ssh-agent) → target "Password:"
#   Password mode: "Vault Password:" → target "Password:"
#   → Interactive shell on the target server

set -euo pipefail

# =============================================================================
# CONFIG — the script looks for a config file in this order:
#   1. $PSM_CONFIG (if set)
#   2. ~/.config/psm/config
#   3. ~/.psmrc
# The first one found is sourced. If none is found, the defaults below apply.
#
# Precedence (depends on how you write the config file):
#   - `VAULT_USER="foo"`              → config overrides the environment
#   - `: "${VAULT_USER:=foo}"`        → environment keeps priority
# =============================================================================
PSM_CONFIG="${PSM_CONFIG:-}"
for _candidate in "$PSM_CONFIG" "$HOME/.config/psm/config" "$HOME/.psmrc"; do
    if [[ -n "$_candidate" && -f "$_candidate" ]]; then
        # shellcheck source=/dev/null
        source "$_candidate"
        break
    fi
done
unset _candidate

PSMP_HOST="${PSMP_HOST:-psmp.example.com}"
VAULT_USER="${VAULT_USER:-your.vault.user}"
KDBX_PATH="${KDBX_PATH:-$HOME/Passwords.kdbx}"
KDBX_GROUP="${KDBX_GROUP:-PSM}"
VAULT_PASS_ENTRY="${VAULT_PASS_ENTRY:-VaultPassword}"
GPG_MASTER_FILE="${GPG_MASTER_FILE:-$HOME/.psm-master.gpg}"
LDAP_USER="${LDAP_USER:-}"  # list of LDAP/AD users (space-separated), e.g. "john.doe jane.smith"
SSH_OPTS="${SSH_OPTS:--o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o LogLevel=ERROR}"
EXPECT_TIMEOUT="${EXPECT_TIMEOUT:-30}"
AUTO_SUDO="${AUTO_SUDO:-1}"  # 1 = auto-fill [sudo] prompts with TARGET_PASS; 0 = manual sudo

# =============================================================================
# Colors (disabled when stderr is not a terminal)
# =============================================================================
if [[ -t 2 ]]; then
    C_RED=$'\033[31m'
    C_GRN=$'\033[32m'
    C_YLW=$'\033[33m'
    C_CYN=$'\033[36m'
    C_RST=$'\033[0m'
else
    C_RED='' C_GRN='' C_YLW='' C_CYN='' C_RST=''
fi

err()   { printf '%s[ERR]%s  %s\n'  "$C_RED" "$C_RST" "$*" >&2; }
warn()  { printf '%s[WARN]%s %s\n'  "$C_YLW" "$C_RST" "$*" >&2; }
info()  { printf '%s[INFO]%s %s\n'  "$C_CYN" "$C_RST" "$*" >&2; }
debug() { [[ "${DEBUG:-0}" == 1 ]] && printf '%s[DBG]%s  %s\n' "$C_GRN" "$C_RST" "$*" >&2 || true; }

# =============================================================================
# Help
# =============================================================================
usage() {
    cat <<EOF
Usage: psm [options] <targetuser@targethost|targethost> [command]
       psm [options] cp [scp-flags] SRC... DST

Connects to a target server through the CyberArk PSMP proxy.
Retrieves the passwords (vault + target) from KeePassXC.

If the target is a bare hostname (e.g. 'srv-prod01'), the user is taken
from the 'User' field of ~/.ssh/config for that host.

Options:
  -d          Debug mode (shows all expect exchanges)
  -S          Disable auto-sudo for this session (manual sudo)
  -l          List the targets available in KeePassXC
  -p PORT     PSMP SSH port (default: 22)
  -v VUSER    Override the vault user (default: \$VAULT_USER)
  -h          Show this help

Examples:
  psm admin@srv-prod01            # explicit user@host syntax
  psm srv-prod01                  # user taken from ~/.ssh/config
  psm -d root@switch-core01
  psm -p 2222 admin@srv-prod01
  psm -l
  psm srv-prod01 "systemctl status nginx"   # run a command (non-interactive)
  psm cp ./deploy.sh srv-prod01:/tmp/        # push a file (scp)
  psm cp srv-prod01:/etc/hosts .             # fetch a file
  psm cp -r ./dist srv-prod01:/var/www/      # recursive transfer

Current configuration:
  PSMP_HOST          = $PSMP_HOST
  VAULT_USER         = $VAULT_USER
  KDBX_GROUP         = $KDBX_GROUP
  VAULT_PASS_ENTRY   = $VAULT_PASS_ENTRY
  LDAP_USER          = ${LDAP_USER:-<unset>}
  AUTO_SUDO          = ${AUTO_SUDO:-1}

Supported environment variables:
  PSMP_HOST, VAULT_USER, KDBX_PATH, KDBX_GROUP,
  VAULT_PASS_ENTRY, GPG_MASTER_FILE, LDAP_USER,
  SSH_OPTS, EXPECT_TIMEOUT, AUTO_SUDO

Per-host PSMP override (~/.ssh/config):
  Host LC*
      SetEnv PSM_PSMP_HOST=psmp-secure.example.com
EOF
}

# =============================================================================
# Dependency check
# =============================================================================
check_deps() {
    local missing=()
    command -v expect >/dev/null 2>&1 || missing+=("expect")
    command -v ssh    >/dev/null 2>&1 || missing+=("ssh")

    if (( ${#missing[@]} > 0 )); then
        err "Missing dependencies:"
        for m in "${missing[@]}"; do err "  - $m"; done
        err "Install on Debian/Ubuntu: apt install expect openssh-client"
        err "Install on RHEL/Fedora  : dnf install expect openssh-clients"
        exit 2
    fi

    # Credential sources: at least one is required
    local has_secret_tool=0 has_keepassxc=0
    command -v secret-tool   >/dev/null 2>&1 && has_secret_tool=1
    command -v keepassxc-cli >/dev/null 2>&1 && has_keepassxc=1

    if (( !has_secret_tool && !has_keepassxc )); then
        err "No credential source available"
        err "Install at least one of the following tools:"
        err "  - secret-tool   (libsecret-tools): KeePassXC GUI + Secret Service"
        err "  - keepassxc-cli                  : command line + GPG"
        exit 2
    fi

    (( has_secret_tool )) || debug "secret-tool not found: Secret Service mode disabled"
    (( has_keepassxc ))   || debug "keepassxc-cli not found: CLI mode disabled"
}

# =============================================================================
# Password retrieval: Secret Service → keepassxc-cli fallback
# =============================================================================
fetch_password() {
    local entry="$1"
    local quiet="${2:-0}"
    local pass=""

    # 1. Secret Service (KeePassXC GUI unlocked + integration enabled)
    if command -v secret-tool >/dev/null 2>&1; then
        if pass=$(secret-tool lookup Title "$entry" 2>/dev/null) && [[ -n "$pass" ]]; then
            debug "Password retrieved via secret-tool for '$entry'"
            printf '%s' "$pass"
            return 0
        fi
        debug "secret-tool failed for '$entry', trying keepassxc-cli"
    fi

    # 2. keepassxc-cli with the master password decrypted by GPG (gpg-agent caches the passphrase)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        if [[ -f "$GPG_MASTER_FILE" ]] && command -v gpg >/dev/null 2>&1; then
            debug "Decrypting the master password via GPG ($GPG_MASTER_FILE)"
            if pass=$(gpg -qd "$GPG_MASTER_FILE" 2>/dev/null \
                       | keepassxc-cli show -qsa Password "$KDBX_PATH" "$KDBX_GROUP/$entry" 2>/dev/null) \
               && [[ -n "$pass" ]]; then
                debug "Password retrieved via keepassxc-cli + GPG for '$entry'"
                printf '%s' "$pass"
                return 0
            fi
        fi

        # 3. Interactive fallback — only when GPG is NOT configured
        # (if GPG_MASTER_FILE exists, the database is assumed to be decryptable:
        # a failure means "entry not found", not "database unreachable" — so
        # there is no point prompting for the master password interactively)
        # The -q flag is dropped here because it suppressed the master password prompt.
        if (( ! quiet )) && [[ ! -f "$GPG_MASTER_FILE" ]]; then
            debug "Interactive keepassxc-cli fallback for '$entry'"
            if pass=$(keepassxc-cli show -sa Password "$KDBX_PATH" "$KDBX_GROUP/$entry") \
               && [[ -n "$pass" ]]; then
                debug "Password retrieved via keepassxc-cli for '$entry'"
                printf '%s' "$pass"
                return 0
            fi
        fi
    fi

    if (( quiet )); then
        debug "Silent lookup failed for '$entry'"
        return 1
    fi

    err "Unable to retrieve the password for: $entry"
    err "Check that:"
    err "  - KeePassXC is open and unlocked (Secret Service mode)"
    err "  - Or ~/.psm-master.gpg exists (keepassxc-cli + GPG mode)"
    err "  - The '$KDBX_GROUP' group contains the '$entry' entry"
    return 1
}

# =============================================================================
# List the targets available in KeePassXC
# =============================================================================
list_targets() {
    info "Targets available in group '$KDBX_GROUP':"

    # secret-tool search returns the entries that have a given attribute.
    # We look for entries with an xdg:schema attribute (all KeePassXC entries)
    # and then keep the ones in user@host format.
    local found=0
    if command -v secret-tool >/dev/null 2>&1; then
        while IFS= read -r title; do
            if [[ "$title" == *@* && "$title" != "$VAULT_PASS_ENTRY" ]]; then
                printf '  %s\n' "$title"
                found=1
            fi
        done < <(secret-tool search --all xdg:schema org.freedesktop.Secret.Generic 2>/dev/null | \
                 awk -F' = ' '/^attribute\.Title/ {print $2}' | sort -u)
    fi
    if (( found )); then
        return 0
    fi

    # keepassxc-cli fallback (GPG first, then interactive)
    if command -v keepassxc-cli >/dev/null 2>&1 && [[ -f "$KDBX_PATH" ]]; then
        local entries=""
        if [[ -f "$GPG_MASTER_FILE" ]] && command -v gpg >/dev/null 2>&1; then
            debug "Listing via keepassxc-cli + GPG"
            entries=$(gpg -qd "$GPG_MASTER_FILE" 2>/dev/null \
                      | keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null) || true
        fi
        if [[ -z "$entries" ]]; then
            warn "Interactive keepassxc-cli fallback (master password required)"
            entries=$(keepassxc-cli ls -q "$KDBX_PATH" "$KDBX_GROUP" 2>/dev/null) || true
        fi
        if [[ -n "$entries" ]]; then
            printf '%s\n' "$entries" | grep -v '^VaultPassword' | sed 's/^/  /'
            return 0
        fi
    fi

    err "No source available to list the targets"
    return 1
}

# =============================================================================
# Parsing of the `psm cp` arguments: finds the single remote spec
# (standard scp rule: a ':' before any '/', form [user@]host:path).
# Flags (-x) and local paths are ignored for the detection.
# =============================================================================
parse_scp_args() {
    PSA_REMOTE_HOST=""
    PSA_REMOTE_PATH=""
    PSA_REMOTE_INDEX=-1
    PSA_ARGV=("$@")
    local i arg count=0
    for i in "${!PSA_ARGV[@]}"; do
        arg="${PSA_ARGV[$i]}"
        [[ "$arg" == -* ]] && continue          # scp flag: never a remote spec
        if [[ "$arg" =~ ^[^/]*: ]]; then         # ':' before any '/'
            PSA_REMOTE_INDEX=$i
            PSA_REMOTE_HOST="${arg%%:*}"
            PSA_REMOTE_PATH="${arg#*:}"
            (( count++ )) || true
        fi
    done

    if (( count == 0 )); then
        err "psm cp: no remote target (expected 'host:/path')"
        return 2
    fi
    if (( count > 1 )); then
        err "psm cp: remote-to-remote transfer is not supported (a single 'host:/path' target)"
        return 2
    fi
    return 0
}

# =============================================================================
# Target resolution + credential fetch
# =============================================================================
resolve_target() {
    # Single-shot per invocation: the R_* globals are not reset on entry (only
    # R_PSMP_HOST is re-initialized). Do not call this in a loop without an exit
    # in between, or R_* values from a previous call could persist.
    local target="$1" port="$2"
    local target_user="" target_host=""
    R_PSMP_HOST="$PSMP_HOST"

    # Parse the target: 'user@host' or bare 'host' (the user is then taken from ~/.ssh/config)
    if [[ "$target" == *@* ]]; then
        target_user="${target%@*}"
        target_host="${target#*@}"
        if [[ -z "$target_user" || -z "$target_host" ]]; then
            err "Invalid format: '$target' (expected: user@host or host)"
            exit 2
        fi
    else
        target_host="$target"
    fi

    # Resolution via ssh -G: gets the hostname AND the user (if not given)
    local original_host="$target_host"
    local ssh_g_output
    debug "Resolving ssh -G $target_host"
    local ssh_g_stderr="/dev/null"
    [[ "${DEBUG:-0}" == 1 ]] && ssh_g_stderr="/dev/stderr"
    if ! ssh_g_output=$(ssh -G "$target_host" 2>"$ssh_g_stderr"); then
        err "ssh -G failed for '$target_host' — check ~/.ssh/config"
        exit 2
    fi

    local resolved
    resolved=$(awk '/^hostname / {print $2}' <<< "$ssh_g_output")
    [[ -n "$resolved" ]] && target_host="$resolved"

    # If no user was given on the command line, take it from ssh -G
    if [[ -z "$target_user" ]]; then
        target_user=$(awk '/^user / {print $2}' <<< "$ssh_g_output")
        if [[ -z "$target_user" ]]; then
            err "No user specified for '$original_host'"
            err "Use the 'user@host' syntax or add 'User xxx' to ~/.ssh/config"
            exit 2
        fi
        debug "User taken from ~/.ssh/config: $target_user"
    fi

    # Override PSMP_HOST if SetEnv PSM_PSMP_HOST=... is set in ~/.ssh/config
    # (e.g. Host LC*  /  SetEnv PSM_PSMP_HOST=psmp-secure.example.com)
    local host_psmp
    host_psmp=$(awk '/^setenv PSM_PSMP_HOST=/ {sub(/^setenv PSM_PSMP_HOST=/,""); print; exit}' <<< "$ssh_g_output")
    if [[ -n "$host_psmp" ]]; then
        debug "PSMP_HOST overridden by ~/.ssh/config: $PSMP_HOST → $host_psmp"
        R_PSMP_HOST="$host_psmp"
    fi
    # 2. /etc/hosts + DNS (2s timeout to avoid hanging)
    if [[ ! "$target_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        debug "DNS resolution: getent hosts $target_host (2s timeout)"
        local ip
        ip=$(timeout 2 getent hosts "$target_host" 2>/dev/null | awk '{print $1}') || true
        if [[ -n "$ip" ]]; then
            target_host="$ip"
        else
            debug "DNS not resolved, hostname passed as is"
        fi
    fi
    if [[ "$target_host" != "$original_host" ]]; then
        debug "Resolution: $original_host → $target_host"
        info "Target: $target_user @ $original_host → $target_host (via $R_PSMP_HOST:$port)"
    else
        info "Target: $target_user @ $target_host (via $R_PSMP_HOST:$port)"
    fi

    # Vault password: not needed with SSH key auth (agent running with loaded keys)
    local vault_pass="" target_pass=""
    local original_target="${target_user}@${original_host}"
    local resolved_target="${target_user}@${target_host}"
    debug "Checking ssh-agent"
    if ssh-add -l >/dev/null 2>&1; then
        info "SSH key mode (agent running, keys loaded)"
    else
        debug "No SSH key, fetching the vault password"
        vault_pass=$(fetch_password "$VAULT_PASS_ENTRY" 1) || true
        if [[ -n "$vault_pass" ]]; then
            info "Password mode (vault password from KeePassXC)"
        else
            # SSH keys present but not loaded → actionable error
            local unloaded_keys
            unloaded_keys=$(find ~/.ssh -maxdepth 1 -name "id_*" ! -name "*.pub" 2>/dev/null)
            if [[ -n "$unloaded_keys" ]]; then
                err "SSH keys found but not loaded in the agent:"
                while IFS= read -r kf; do err "  - $kf"; done <<< "$unloaded_keys"
                err "Load them first: ssh-add"
                exit 2
            fi
            warn "No vault password, and ssh-agent has no key loaded"
            warn "If the PSMP asks for a vault password, the connection will fail"
        fi
    fi

    # Target password: required
    # Lookup order — depends on whether target_user is a known LDAP account (LDAP_USER)
    #   Known LDAP account: user → user@ip → user@hostname  (single entry, same password everywhere)
    #   Service account   : user@ip → user@hostname → user  (specific before generic)
    local is_ldap=0 u
    for u in $LDAP_USER; do
        if [[ "$target_user" == "$u" ]]; then
            is_ldap=1
            break
        fi
    done

    local lookup_names=()
    if (( is_ldap )); then
        debug "User '$target_user' identified as an LDAP account (via LDAP_USER)"
        lookup_names=("$target_user")
        if [[ "$resolved_target" != "$original_target" ]]; then
            lookup_names+=("$resolved_target" "$original_target")
        else
            lookup_names+=("$original_target")
        fi
    else
        if [[ "$resolved_target" != "$original_target" ]]; then
            lookup_names=("$resolved_target" "$original_target" "$target_user")
        else
            lookup_names=("$original_target" "$target_user")
        fi
    fi

    info "Looking up the target password in KeePassXC..."
    local found_name=""
    for name in "${lookup_names[@]}"; do
        debug "Lookup '$name'"
        target_pass=$(fetch_password "$name" 1) || true
        if [[ -n "$target_pass" ]]; then
            found_name="$name"
            break
        fi
    done

    if [[ -z "$target_pass" ]]; then
        err "No KeePassXC entry found for '$target_user'"
        err "Names tried:"
        for name in "${lookup_names[@]}"; do
            err "  - $KDBX_GROUP/$name"
        done
        err "Create an entry with one of these Titles in group '$KDBX_GROUP'"
        exit 3
    fi
    info "Password found (entry: $KDBX_GROUP/$found_name)"

    # Build the CyberArk connection string (resolved IP for the PSMP)
    R_TARGET_USER="$target_user"
    R_TARGET_HOST="$target_host"
    R_ORIGINAL_HOST="$original_host"
    R_VAULT_PASS="$vault_pass"
    R_TARGET_PASS="$target_pass"
    R_CONN_STR="${VAULT_USER}@${target_user}@${target_host}@${R_PSMP_HOST}"
    unset vault_pass target_pass
}

# =============================================================================
# Expect preamble shared by the 3 modes: vault auth (optional) → target.
# $1 = full `spawn` line (Tcl syntax; literal \$env(...)).
# Writes the script to stdout.
# =============================================================================
emit_auth_preamble() {
    local spawn_line="$1"
    local log_init=0 exp_debug=0
    if [[ "${DEBUG:-0}" == 1 ]]; then
        log_init=1
        exp_debug=1
    fi

    # Escaping convention (NON-quoted heredoc <<EXPECT_EOF):
    #   $var   → expanded by bash   ($spawn_line, $EXPECT_TIMEOUT, $VAULT_PASS_ENTRY)
    #   \$var  → literal for Tcl    ($env(CONN_STR/VAULT_PASS/TARGET_PASS), ${c_red})
    #   \[..\] and \033 → literal for Tcl (prevents command substitution / expansion)
    # Secrets only go through $env(...), never on the command line.
    cat <<EXPECT_EOF
        log_user $log_init
        exp_internal $exp_debug
        set timeout $EXPECT_TIMEOUT

        set c_red "\033\[31m"
        set c_ylw "\033\[33m"
        set c_rst "\033\[0m"

        $spawn_line

        expect {
            -re {(?i)enter passphrase for} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} SSH passphrase requested — key not loaded in the agent\n"
                send_user "\${c_ylw}\[WARN\]\${c_rst} Load your key first: ssh-add\n"
                exit 14
            }
            -re {(?i)vault password\s*:\s*\$} {
                if {\$env(VAULT_PASS) eq ""} {
                    send_user "\n\${c_red}\[ERR\]\${c_rst} Vault password requested but none available\n"
                    send_user "\${c_ylw}\[WARN\]\${c_rst} Set up the '$VAULT_PASS_ENTRY' entry in KeePassXC or use an SSH key\n"
                    exit 10
                }
                log_user 1
                send -- "\$env(VAULT_PASS)\r"

                expect {
                    -re {(?i)vault password\s*:\s*\$} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Vault authentication failed (wrong VaultPassword)\n"
                        exit 20
                    }
                    -re {(?i)(otp|one-time password|mfa code)\s*:\s*\$} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} MFA detected — not supported by this script\n"
                        exit 21
                    }
                    -re {(?i)permission denied} {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Permission denied after the vault password\n"
                        exit 22
                    }
                    -re {(?i)password\s*:\s*\$} {
                        send -- "\$env(TARGET_PASS)\r"
                    }
                    timeout {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Timeout waiting for the target prompt\n"
                        exit 23
                    }
                    eof {
                        send_user "\n\${c_red}\[ERR\]\${c_rst} Connection closed before the target prompt\n"
                        exit 24
                    }
                }
            }
            -re {(?i)password\s*:\s*\$} {
                log_user 1
                send -- "\$env(TARGET_PASS)\r"
            }
            -re {(?i)permission denied} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Permission denied (SSH key rejected?)\n"
                exit 13
            }
            timeout {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Timeout waiting for an authentication prompt\n"
                exit 11
            }
            eof {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Connection closed before authentication\n"
                exit 12
            }
        }
EXPECT_EOF
}

# =============================================================================
# Interactive SSH connection via expect (shared preamble + auto-sudo interact)
# =============================================================================
run_shell() {
    local target="$1" port="$2"

    resolve_target "$target" "$port"
    export VAULT_PASS="$R_VAULT_PASS"
    export TARGET_PASS="$R_TARGET_PASS"
    export CONN_STR="$R_CONN_STR"
    debug "Spawn: ssh -p $port $SSH_OPTS $R_CONN_STR"

    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Debug mode: passwords will be visible in the expect output"
    fi

    if [[ "${AUTO_SUDO:-1}" == 1 ]]; then
        info "Auto-sudo on (the target password answers [sudo] prompts)"
    else
        info "Auto-sudo off — manual sudo"
    fi

    local rc=0 expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    local spawn_line="spawn -noecho ssh -p $port $SSH_OPTS \$env(CONN_STR)"

    {
        emit_auth_preamble "$spawn_line"
        cat <<EXPECT_EOF

        set timeout 3
        expect {
            -re {(?i)permission denied} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Target authentication failed\n"
                exit 30
            }
            -re {(?i)password\s*:\s*\$} {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Target re-prompt → wrong TARGET_PASS\n"
                exit 31
            }
            eof {
                send_user "\n\${c_red}\[ERR\]\${c_rst} Connection closed after target auth\n"
                exit 32
            }
            timeout {}
            -re {.+} {}
        }

        set timeout -1
EXPECT_EOF
        # Conditional auto-sudo hook: AUTO_SUDO=1 answers [sudo] prompts with
        # the target password; AUTO_SUDO=0 → bare interact (manual sudo).
        if [[ "${AUTO_SUDO:-1}" == 1 ]]; then
            cat <<EXPECT_EOF
        interact -o -re {\[sudo\] [Pp]assword[^:]*:} {
            send -- "\$env(TARGET_PASS)\r"
        }
EXPECT_EOF
        else
            printf '        interact\n'
        fi
    } > "$expect_script"

    expect -f "$expect_script" || rc=$?
    rm -f "$expect_script"
    unset VAULT_PASS TARGET_PASS CONN_STR
    return $rc
}

# =============================================================================
# Expect tail shared by the non-interactive modes (exec, scp): shows the
# output of the spawned process, then propagates its exit code. Quoted
# heredoc (<<'EXPECT_EOF'): literal Tcl only, no bash expansion.
# =============================================================================
emit_noninteractive_tail() {
    cat <<'EXPECT_EOF'

        log_user 1
        set timeout -1
        expect eof
        catch wait result
        exit [lindex $result 3]
EXPECT_EOF
}

# =============================================================================
# Non-interactive execution of a remote command (like `ssh host "cmd"`).
# The command goes through $env(REMOTE_CMD): a single Tcl word, passed as is
# to the remote shell, with no Tcl substitution or backslash processing.
# =============================================================================
run_exec() {
    local target="$1" port="$2" remote_cmd="$3"

    resolve_target "$target" "$port"
    export VAULT_PASS="$R_VAULT_PASS"
    export TARGET_PASS="$R_TARGET_PASS"
    export CONN_STR="$R_CONN_STR"
    export REMOTE_CMD="$remote_cmd"
    debug "Spawn: ssh -p $port $SSH_OPTS $R_CONN_STR $remote_cmd"
    info "Running: $remote_cmd"

    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Debug mode: passwords will be visible in the expect output"
    fi

    local rc=0 expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    local spawn_line="spawn -noecho ssh -p $port $SSH_OPTS \$env(CONN_STR) \$env(REMOTE_CMD)"

    { emit_auth_preamble "$spawn_line"; emit_noninteractive_tail; } > "$expect_script"

    expect -f "$expect_script" || rc=$?
    rm -f "$expect_script"
    unset VAULT_PASS TARGET_PASS CONN_STR REMOTE_CMD
    return $rc
}

# =============================================================================
# File transfer via scp through the PSMP.
# Args = raw arguments after `cp` (scp flags + paths + one remote spec).
# =============================================================================
run_scp() {
    parse_scp_args "$@" || exit $?

    resolve_target "$PSA_REMOTE_HOST" "$PORT"
    # Rewrite the single remote spec with the CyberArk conn_str (resolved IP).
    PSA_ARGV[$PSA_REMOTE_INDEX]="${R_CONN_STR}:${PSA_REMOTE_PATH}"

    export VAULT_PASS="$R_VAULT_PASS"
    export TARGET_PASS="$R_TARGET_PASS"
    debug "Spawn: scp -P $PORT $SSH_OPTS ${PSA_ARGV[*]}"
    info "scp transfer via $R_PSMP_HOST"

    if [[ "${DEBUG:-0}" == 1 ]]; then
        warn "Debug mode: passwords will be visible in the expect output"
    fi

    local rc=0 expect_script
    expect_script=$(mktemp /tmp/psm-expect.XXXXXX)
    # {*}$argv: Tcl expansion of the scp arguments (passed after -- below).
    local spawn_line="spawn -noecho scp -P $PORT $SSH_OPTS {*}\$argv"

    { emit_auth_preamble "$spawn_line"; emit_noninteractive_tail; } > "$expect_script"

    expect -f "$expect_script" -- "${PSA_ARGV[@]}" || rc=$?
    rm -f "$expect_script"
    unset VAULT_PASS TARGET_PASS
    return $rc
}

# =============================================================================
# Entry point
# =============================================================================
main() {
    DEBUG=0
    PORT=22
    LIST_ONLY=0

    while getopts ":dlp:v:hS" opt; do
        case "$opt" in
            d) DEBUG=1 ;;
            S) AUTO_SUDO=0 ;;
            l) LIST_ONLY=1 ;;
            p) PORT="$OPTARG" ;;
            v) VAULT_USER="$OPTARG" ;;
            h) usage; exit 0 ;;
            \?) err "Unknown option: -$OPTARG"; usage; exit 2 ;;
            :)  err "Option -$OPTARG requires an argument"; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))

    # Leftover secrets detection (cleanup of a previous session failed)
    if [[ -n "${VAULT_PASS:-}" || -n "${TARGET_PASS:-}" ]]; then
        warn "Leftover secrets found in the environment (previous session did not exit cleanly) — purging"
        unset VAULT_PASS TARGET_PASS
    fi

    check_deps

    if (( LIST_ONLY == 1 )); then
        list_targets
        exit $?
    fi

    if (( $# < 1 )); then
        err "Missing argument: <targetuser@targethost> [command]"
        usage
        exit 2
    fi

    # Port validation
    if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
        err "Invalid port: $PORT"
        exit 2
    fi

    if [[ "$1" == "cp" ]]; then
        shift
        if (( $# < 2 )); then
            err "Usage: psm cp [flags] SRC... DST"
            exit 2
        fi
        run_scp "$@"
        exit $?
    fi

    local target="$1"; shift
    if (( $# > 0 )); then
        run_exec "$target" "$PORT" "$*"       # psm host "cmd..."
    else
        run_shell "$target" "$PORT"           # psm host  (interactive shell)
    fi
}

# Only run main when the script is executed directly (not when sourced by the tests)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
